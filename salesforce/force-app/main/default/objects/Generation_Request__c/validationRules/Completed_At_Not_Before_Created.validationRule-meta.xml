<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Completed_At_Not_Before_Created</fullName>
    <active>true</active>
    <description>Ensures Completed At is not earlier than CreatedDate.</description>
    <errorConditionFormula>AND(NOT(ISBLANK(Completed_At__c)), Completed_At__c &lt; CreatedDate)</errorConditionFormula>
    <errorDisplayField>Completed_At__c</errorDisplayField>
    <errorMessage>Completed At cannot be earlier than CreatedDate.</errorMessage>
</ValidationRule>


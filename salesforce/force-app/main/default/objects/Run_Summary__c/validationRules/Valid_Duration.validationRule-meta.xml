<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Valid_Duration</fullName>
    <active>true</active>
    <description>Execution duration must be non-negative (SF-09).</description>
    <errorConditionFormula>Duration_Seconds__c &lt; 0</errorConditionFormula>
    <errorMessage>Duration in seconds must be greater than or equal to zero.</errorMessage>
</ValidationRule>


            <name>Instructions_Text</name>
            <fieldText>&lt;p&gt;&lt;b&gt;Queue a Tailored Cover Letter Draft&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Select generation options below. Submitting queues the request in Salesforce. When the local worker is started on your Windows computer, it will claim and generate the draft.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>

            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Context_Strategy_Input</name>
            <choiceReferences>Choice_Context_JSON</choiceReferences>
            <choiceReferences>Choice_Context_RAG</choiceReferences>
            <dataType>String</dataType>
            <defaultSelectedChoiceReference>Choice_Context_JSON</defaultSelectedChoiceReference>
            <fieldText>Context Strategy</fieldText>

/**
 * @description Review decision service managing version-specific human approval,
 *              atomic supersession, audit event logging, and parent locking (SF-07).
 */
public with sharing class JA_ArtifactReviewService {

    public class ReviewCommandInput {
        @AuraEnabled public String action; // 'approve', 'approve_and_replace', 'supersede'
        @AuraEnabled public Id selectedReviewId;
        @AuraEnabled public String expectedVersionId;
        @AuraEnabled public String expectedContentHash;
        @AuraEnabled public Integer expectedReviewRevision;
        @AuraEnabled public String intentToken;
        @AuraEnabled public Id replacedReviewId;
        @AuraEnabled public String candidateNotes;
        @AuraEnabled public Boolean explicitAcknowledgment;
    }

    public class ReviewCommandResult {
        @AuraEnabled public Boolean isSuccess;
        @AuraEnabled public String outcome; // 'recorded', 'replayed', 'conflict', 'rejected'
        @AuraEnabled public Id eventId;
        @AuraEnabled public String currentStatus;
        @AuraEnabled public String errorReason;
        @AuraEnabled public String errorMessage;
    }

    public class FormatCardDTO {
        @AuraEnabled public String format;
        @AuraEnabled public Id reviewId;
        @AuraEnabled public String contentVersionId;
        @AuraEnabled public String contentDocumentId;
        @AuraEnabled public String contentHash;
        @AuraEnabled public Decimal sizeBytes;
        @AuraEnabled public String deliveryStatus;
        @AuraEnabled public String approvalStatus;
        @AuraEnabled public Datetime deliveredAt;
        @AuraEnabled public Datetime approvedAt;
        @AuraEnabled public String approvedBy;
        @AuraEnabled public Boolean isAccessible;
        @AuraEnabled public String downloadUrl;
        @AuraEnabled public Boolean canApprove;
        @AuraEnabled public Boolean canApproveAndReplace;
        @AuraEnabled public Boolean canSupersede;
        @AuraEnabled public String accessMessage;
    }

    public class ReviewUIStateDTO {
        @AuraEnabled public Id requestId;
        @AuraEnabled public String requestName;
        @AuraEnabled public Id jobId;
        @AuraEnabled public String jobTitle;
        @AuraEnabled public String documentType;
        @AuraEnabled public String language;
        @AuraEnabled public String templateId;
        @AuraEnabled public String requestStatus;
        @AuraEnabled public String statusHeadline;
        @AuraEnabled public String statusDescription;
        @AuraEnabled public String statutoryWarning;
        @AuraEnabled public List<String> warnings;
        @AuraEnabled public List<FormatCardDTO> formatCards;
        @AuraEnabled public Boolean allFormatsDelivered;
        @AuraEnabled public Boolean canRegenerate;
        @AuraEnabled public String errorMessage;
    }

    private static final String STATUTORY_NOTICE = 
        'Draft generated by automated pipeline. Review claims, dates, and subjective phrasing ' +
        'before formal approval or job submission.';

    @AuraEnabled(cacheable=true)
    public static ReviewUIStateDTO getReviewUIState(Id requestId) {
        if (requestId == null) {
            throw new AuraHandledException('Request ID is required.');
        }

        List<Generation_Request__c> reqs = [
            SELECT Id, Name, Job__c, Job__r.Job_Title__c, Document_Type__c, Language__c,
                   Template_Id__c, Status__c, Error_Message__c, Error_Reason__c
            FROM Generation_Request__c
            WHERE Id = :requestId
            LIMIT 1
        ];

        if (reqs.isEmpty()) {
            throw new AuraHandledException('Generation Request record not found.');
        }

        Generation_Request__c req = reqs[0];
        ReviewUIStateDTO state = new ReviewUIStateDTO();
        state.requestId = req.Id;
        state.requestName = req.Name;
        state.jobId = req.Job__c;
        state.jobTitle = req.Job__r.Job_Title__c;
        state.documentType = req.Document_Type__c;
        state.language = req.Language__c;
        state.templateId = req.Template_Id__c;
        state.requestStatus = req.Status__c;
        state.statutoryWarning = STATUTORY_NOTICE;
        state.warnings = new List<String>();
        state.formatCards = new List<FormatCardDTO>();
        state.canRegenerate = true;
        state.errorMessage = req.Error_Message__c;

        if (req.Status__c == 'Pending') {
            state.statusHeadline = 'Queued — waiting for the local worker';
            state.statusDescription = 'Request is queued in Salesforce. It will be processed when the local worker runs on your Windows machine.';
        } else if (req.Status__c == 'Running') {
            state.statusHeadline = 'Generating';
            state.statusDescription = 'The local worker has claimed this request and is generating your draft document.';
        } else if (req.Status__c == 'Upload_Pending') {
            state.statusHeadline = 'Upload pending — draft is not yet ready for review';
            state.statusDescription = 'The draft document is generated, but file upload to Salesforce Files is pending.';
        } else if (req.Status__c == 'Ready_for_Review') {
            state.statusHeadline = 'Delivered — ready for review';
            state.statusDescription = 'Both DOCX and PDF drafts have been delivered. Review each version and approve when satisfied.';
        } else if (req.Status__c == 'Failed') {
            state.statusHeadline = 'Generation failed';
            state.statusDescription = String.isNotBlank(req.Error_Message__c) ? req.Error_Message__c : 'Processing error occurred.';
        }

        // Query reviews for this request
        List<JA_Artifact_Review__c> reviews = [
            SELECT Id, Name, Format__c, Content_Version_Id__c, Content_Document_Id__c,
                   Content_Hash__c, Size_Bytes__c, Approval_Status__c, Delivered_At__c,
                   Approved_At__c, Approved_By__c, Safe_Warnings__c
            FROM JA_Artifact_Review__c
            WHERE Generation_Request__c = :requestId
        ];

        Map<String, JA_Artifact_Review__c> revByFormat = new Map<String, JA_Artifact_Review__c>();
        for (JA_Artifact_Review__c r : reviews) {
            revByFormat.put(r.Format__c.toLowerCase(), r);
            if (String.isNotBlank(r.Safe_Warnings__c)) {
                state.warnings.add(r.Safe_Warnings__c);
            }
        }

        // Query currently approved versions for the job/doc_type
        Map<String, JA_Artifact_Review__c> existingApprovedByFmt = new Map<String, JA_Artifact_Review__c>();
        for (JA_Artifact_Review__c appRev : [
            SELECT Id, Format__c, Name
            FROM JA_Artifact_Review__c
            WHERE Generation_Request__r.Job__c = :req.Job__c
              AND Generation_Request__r.Document_Type__c = :req.Document_Type__c
              AND Approval_Status__c = 'approved'
        ]) {
            existingApprovedByFmt.put(appRev.Format__c.toLowerCase(), appRev);
        }

        Boolean allDelivered = true;
        for (String fmt : new List<String>{'docx', 'pdf'}) {
            FormatCardDTO card = new FormatCardDTO();
            card.format = fmt;
            if (revByFormat.containsKey(fmt)) {
                JA_Artifact_Review__c r = revByFormat.get(fmt);
                card.reviewId = r.Id;
                card.contentVersionId = r.Content_Version_Id__c;
                card.contentDocumentId = r.Content_Document_Id__c;
                card.contentHash = r.Content_Hash__c;
                card.sizeBytes = r.Size_Bytes__c;
                card.deliveryStatus = 'delivered';
                card.approvalStatus = r.Approval_Status__c;
                card.deliveredAt = r.Delivered_At__c;
                card.approvedAt = r.Approved_At__c;
                card.approvedBy = r.Approved_By__c;
                card.isAccessible = true;
                card.downloadUrl = '/sfc/servlet.shepherd/version/download/' + r.Content_Version_Id__c;

                Boolean isReady = (req.Status__c == 'Ready_for_Review');
                Boolean hasExistingApp = existingApprovedByFmt.containsKey(fmt);

                card.canApprove = (isReady && r.Approval_Status__c == 'draft' && !hasExistingApp);
                card.canApproveAndReplace = (isReady && r.Approval_Status__c == 'draft' && hasExistingApp && existingApprovedByFmt.get(fmt).Id != r.Id);
                card.canSupersede = (r.Approval_Status__c == 'draft' || r.Approval_Status__c == 'approved');
            } else {
                allDelivered = false;
                card.deliveryStatus = 'upload_pending';
                card.approvalStatus = 'draft';
                card.isAccessible = false;
                card.canApprove = false;
                card.canApproveAndReplace = false;
                card.canSupersede = false;
                card.accessMessage = 'Draft upload is pending.';
            }
            state.formatCards.add(card);
        }

        state.allFormatsDelivered = allDelivered;
        return state;
    }

    @AuraEnabled
    public static ReviewCommandResult executeReviewCommand(ReviewCommandInput input) {
        ReviewCommandResult res = new ReviewCommandResult();
        res.isSuccess = false;

        // 1. Check custom permission
        if (!FeatureManagement.checkPermission('JA_Review_Generated_Documents')) {
            res.outcome = 'rejected';
            res.errorReason = 'insufficient_privilege';
            res.errorMessage = 'You lack the JA_Review_Generated_Documents permission required to approve drafts.';
            return res;
        }

        // 2. Validate input
        if (input == null || input.selectedReviewId == null) {
            res.outcome = 'rejected';
            res.errorReason = 'missing_target_review';
            res.errorMessage = 'Target review ID is required.';
            return res;
        }

        if (String.isBlank(input.intentToken)) {
            res.outcome = 'rejected';
            res.errorReason = 'missing_intent_token';
            res.errorMessage = 'Intent token is required for idempotent decision submission.';
            return res;
        }

        if (input.explicitAcknowledgment != true) {
            res.outcome = 'rejected';
            res.errorReason = 'missing_acknowledgment';
            res.errorMessage = 'Candidate must explicitly confirm reviewing claims, dates, and phrasing.';
            return res;
        }

        String eventKey = UserInfo.getUserId() + ':' + input.intentToken.trim();

        // 3. Check for replay
        List<JA_Artifact_Review_Event__c> existingEvents = [
            SELECT Id, Action__c, New_Status__c, Artifact_Review__c, Selected_Content_Version_Id__c,
                   Selected_Content_Hash__c, Replaced_Artifact_Review__c
            FROM JA_Artifact_Review_Event__c
            WHERE Event_Key__c = :eventKey
            LIMIT 1
        ];

        if (!existingEvents.isEmpty()) {
            JA_Artifact_Review_Event__c existingEvent = existingEvents[0];
            // Check payload consistency
            if (existingEvent.Artifact_Review__c == input.selectedReviewId &&
                existingEvent.Action__c == input.action &&
                existingEvent.Selected_Content_Version_Id__c == input.expectedVersionId) {
                res.isSuccess = true;
                res.outcome = 'replayed';
                res.eventId = existingEvent.Id;
                res.currentStatus = existingEvent.New_Status__c;
                return res;
            } else {
                res.outcome = 'conflict';
                res.errorReason = 'idempotency_payload_conflict';
                res.errorMessage = 'A review decision was already recorded with this token under different parameters.';
                return res;
            }
        }

        // 4. Query target review row
        List<JA_Artifact_Review__c> reviews = [
            SELECT Id, Name, Format__c, Content_Version_Id__c, Content_Hash__c,
                   Approval_Status__c, Review_Revision__c, Generation_Request__c,
                   Generation_Request__r.Job__c, Generation_Request__r.Document_Type__c,
                   Generation_Request__r.Status__c
            FROM JA_Artifact_Review__c
            WHERE Id = :input.selectedReviewId
            LIMIT 1
        ];

        if (reviews.isEmpty()) {
            res.outcome = 'rejected';
            res.errorReason = 'record_not_found';
            res.errorMessage = 'Target review record not found.';
            return res;
        }

        JA_Artifact_Review__c target = reviews[0];

        // Ensure generation request is Ready_for_Review
        if (target.Generation_Request__r.Status__c != 'Ready_for_Review') {
            res.outcome = 'rejected';
            res.errorReason = 'request_not_ready';
            res.errorMessage = 'Request status must be Ready_for_Review before approval.';
            return res;
        }

        // Lock parent Job__c row first, then review row
        Id jobId = target.Generation_Request__r.Job__c;
        if (jobId != null) {
            List<Job__c> lockedJob = [SELECT Id FROM Job__c WHERE Id = :jobId FOR UPDATE];
        }

        List<JA_Artifact_Review__c> lockedTarget = [
            SELECT Id, Name, Format__c, Content_Version_Id__c, Content_Hash__c,
                   Approval_Status__c, Review_Revision__c, Generation_Request__c,
                   Generation_Request__r.Job__c, Generation_Request__r.Document_Type__c
            FROM JA_Artifact_Review__c
            WHERE Id = :input.selectedReviewId
            FOR UPDATE
        ];

        target = lockedTarget[0];

        // 5. Version, hash, and revision check
        if (target.Content_Version_Id__c != input.expectedVersionId) {
            res.outcome = 'conflict';
            res.errorReason = 'version_mismatch';
            res.errorMessage = 'ContentVersion ID mismatch: displayed version does not match database record.';
            return res;
        }

        if (target.Content_Hash__c != input.expectedContentHash) {
            res.outcome = 'conflict';
            res.errorReason = 'hash_mismatch';
            res.errorMessage = 'Content hash mismatch: draft bytes have changed.';
            return res;
        }

        if (target.Review_Revision__c != input.expectedReviewRevision) {
            res.outcome = 'conflict';
            res.errorReason = 'stale_revision';
            res.errorMessage = 'Stale review screen: this record was modified by another action.';
            return res;
        }

        // 6. Execute action
        Datetime now = Datetime.now();
        String currentUserId = UserInfo.getUserId();

        if (input.action == 'approve') {
            if (target.Approval_Status__c != 'draft') {
                res.outcome = 'conflict';
                res.errorReason = 'invalid_state';
                res.errorMessage = 'Only draft records can be approved.';
                return res;
            }

            // Check if an approved record already exists in scope
            List<JA_Artifact_Review__c> existingApproved = [
                SELECT Id, Name
                FROM JA_Artifact_Review__c
                WHERE Generation_Request__r.Job__c = :target.Generation_Request__r.Job__c
                  AND Generation_Request__r.Document_Type__c = :target.Generation_Request__r.Document_Type__c
                  AND Format__c = :target.Format__c
                  AND Approval_Status__c = 'approved'
                LIMIT 1
            ];

            if (!existingApproved.isEmpty()) {
                res.outcome = 'conflict';
                res.errorReason = 'approval_already_exists';
                res.errorMessage = 'An approved ' + target.Format__c.toUpperCase() + ' draft already exists (' + existingApproved[0].Name + '). Use approve_and_replace.';
                return res;
            }

            JA_Artifact_Review_Event__c ev = new JA_Artifact_Review_Event__c();
            ev.Event_Key__c = eventKey;
            ev.Artifact_Review__c = target.Id;
            ev.Action__c = 'approve';
            ev.Previous_Status__c = target.Approval_Status__c;
            ev.New_Status__c = 'approved';
            ev.Prior_Review_Revision__c = target.Review_Revision__c;
            ev.New_Review_Revision__c = target.Review_Revision__c + 1;
            ev.Actor__c = currentUserId;
            ev.Event_Timestamp__c = now;
            ev.Selected_Content_Version_Id__c = target.Content_Version_Id__c;
            ev.Selected_Content_Hash__c = target.Content_Hash__c;
            ev.Candidate_Notes__c = input.candidateNotes;
            insert ev;

            target.Approval_Status__c = 'approved';
            target.Approved_By__c = currentUserId;
            target.Approved_At__c = now;
            target.Approval_Event_Ref__c = ev.Id;
            target.Review_Revision__c += 1;
            update target;

            res.isSuccess = true;
            res.outcome = 'recorded';
            res.eventId = ev.Id;
            res.currentStatus = 'approved';
            return res;

        } else if (input.action == 'approve_and_replace') {
            if (input.replacedReviewId == null) {
                res.outcome = 'rejected';
                res.errorReason = 'missing_replaced_review';
                res.errorMessage = 'Must specify replacedReviewId for approve_and_replace.';
                return res;
            }

            List<JA_Artifact_Review__c> lockedReplaced = [
                SELECT Id, Name, Format__c, Approval_Status__c, Review_Revision__c,
                       Generation_Request__r.Job__c, Generation_Request__r.Document_Type__c
                FROM JA_Artifact_Review__c
                WHERE Id = :input.replacedReviewId
                FOR UPDATE
            ];

            if (lockedReplaced.isEmpty()) {
                res.outcome = 'rejected';
                res.errorReason = 'replaced_record_not_found';
                res.errorMessage = 'Replaced review record not found.';
                return res;
            }

            JA_Artifact_Review__c replaced = lockedReplaced[0];

            if (replaced.Generation_Request__r.Job__c != target.Generation_Request__r.Job__c ||
                replaced.Generation_Request__r.Document_Type__c != target.Generation_Request__r.Document_Type__c) {
                res.outcome = 'rejected';
                res.errorReason = 'cross_job_replacement';
                res.errorMessage = 'Cannot replace an artifact from a different Job or document type.';
                return res;
            }

            if (replaced.Format__c != target.Format__c) {
                res.outcome = 'rejected';
                res.errorReason = 'format_mismatch';
                res.errorMessage = 'Cannot replace ' + replaced.Format__c + ' with ' + target.Format__c + '.';
                return res;
            }

            if (replaced.Approval_Status__c != 'approved') {
                res.outcome = 'conflict';
                res.errorReason = 'stale_replacement_target';
                res.errorMessage = 'Target replaced record is not approved (currently: ' + replaced.Approval_Status__c + ').';
                return res;
            }

            JA_Artifact_Review_Event__c ev = new JA_Artifact_Review_Event__c();
            ev.Event_Key__c = eventKey;
            ev.Artifact_Review__c = target.Id;
            ev.Action__c = 'approve_and_replace';
            ev.Previous_Status__c = target.Approval_Status__c;
            ev.New_Status__c = 'approved';
            ev.Prior_Review_Revision__c = target.Review_Revision__c;
            ev.New_Review_Revision__c = target.Review_Revision__c + 1;
            ev.Actor__c = currentUserId;
            ev.Event_Timestamp__c = now;
            ev.Selected_Content_Version_Id__c = target.Content_Version_Id__c;
            ev.Selected_Content_Hash__c = target.Content_Hash__c;
            ev.Replaced_Artifact_Review__c = replaced.Id;
            ev.Candidate_Notes__c = input.candidateNotes;
            insert ev;

            // Supersede old
            replaced.Approval_Status__c = 'superseded';
            replaced.Superseded_By__c = target.Id;
            replaced.Superseded_At__c = now;
            replaced.Review_Revision__c += 1;
            update replaced;

            // Approve new
            target.Approval_Status__c = 'approved';
            target.Approved_By__c = currentUserId;
            target.Approved_At__c = now;
            target.Approval_Event_Ref__c = ev.Id;
            target.Review_Revision__c += 1;
            update target;

            res.isSuccess = true;
            res.outcome = 'recorded';
            res.eventId = ev.Id;
            res.currentStatus = 'approved';
            return res;

        } else if (input.action == 'supersede') {
            if (target.Approval_Status__c == 'superseded') {
                res.outcome = 'conflict';
                res.errorReason = 'already_superseded';
                res.errorMessage = 'Record is already superseded.';
                return res;
            }

            JA_Artifact_Review_Event__c ev = new JA_Artifact_Review_Event__c();
            ev.Event_Key__c = eventKey;
            ev.Artifact_Review__c = target.Id;
            ev.Action__c = 'supersede';
            ev.Previous_Status__c = target.Approval_Status__c;
            ev.New_Status__c = 'superseded';
            ev.Prior_Review_Revision__c = target.Review_Revision__c;
            ev.New_Review_Revision__c = target.Review_Revision__c + 1;
            ev.Actor__c = currentUserId;
            ev.Event_Timestamp__c = now;
            ev.Selected_Content_Version_Id__c = target.Content_Version_Id__c;
            ev.Selected_Content_Hash__c = target.Content_Hash__c;
            ev.Candidate_Notes__c = input.candidateNotes;
            insert ev;

            target.Approval_Status__c = 'superseded';
            target.Superseded_At__c = now;
            target.Review_Revision__c += 1;
            update target;

            res.isSuccess = true;
            res.outcome = 'recorded';
            res.eventId = ev.Id;
            res.currentStatus = 'superseded';
            return res;
        }

        res.outcome = 'rejected';
        res.errorReason = 'unsupported_action';
        res.errorMessage = 'Action ' + input.action + ' is not supported.';
        return res;
    }
}


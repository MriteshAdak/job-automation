{
  "$defs": {
    "ClassifiedError": {
      "additionalProperties": false,
      "description": "Classified operational or domain error.\n\nDistinguishes recoverable failures from permanent errors and maps\nto the system error taxonomy without arbitrary tool or shell authority.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/ErrorCategory"
        },
        "message": {
          "description": "Safe diagnostic message without credentials or tokens",
          "title": "Message",
          "type": "string"
        },
        "recoverable": {
          "description": "Whether this error category is eligible for bounded retry",
          "title": "Recoverable",
          "type": "boolean"
        },
        "field_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional field path if the error pertains to a specific field",
          "title": "Field Path"
        },
        "details": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Safe non-sensitive contextual details",
          "title": "Details"
        }
      },
      "required": [
        "category",
        "message",
        "recoverable"
      ],
      "title": "ClassifiedError",
      "type": "object"
    },
    "ErrorCategory": {
      "description": "Classified error category for failure handling and recovery.",
      "enum": [
        "validation",
        "missing_configuration",
        "permission",
        "authentication",
        "rate_limit",
        "transient_network",
        "transient_service",
        "context_budget",
        "model_output",
        "capacity",
        "unsupported_input"
      ],
      "title": "ErrorCategory",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Audit receipt recording the outcome of input validation and availability preflight.",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "receipt_id": {
      "format": "uuid",
      "title": "Receipt Id",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "accepted_options_digest": {
      "minLength": 1,
      "title": "Accepted Options Digest",
      "type": "string"
    },
    "freeze_op_id": {
      "minLength": 1,
      "title": "Freeze Op Id",
      "type": "string"
    },
    "started_at": {
      "description": "UTC datetime with +00:00 offset",
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "completed_at": {
      "description": "UTC datetime with +00:00 offset",
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "result": {
      "description": "'prepared' or 'failed'",
      "title": "Result",
      "type": "string"
    },
    "seal_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seal Id"
    },
    "seal_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seal Hash"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClassifiedError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reason_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason Code"
    }
  },
  "required": [
    "request_id",
    "accepted_options_digest",
    "freeze_op_id",
    "started_at",
    "completed_at",
    "result"
  ],
  "title": "PreflightReceipt",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-automation.local/schemas/v1/preflight_receipt.schema.json"
}

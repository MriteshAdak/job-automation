{
  "$defs": {
    "CandidateEvidenceReference": {
      "additionalProperties": false,
      "description": "Reference citing an approved candidate profile fact.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_kind": {
          "const": "candidate",
          "default": "candidate",
          "title": "Source Kind",
          "type": "string"
        },
        "profile_version": {
          "description": "Version of the profile snapshot",
          "minLength": 1,
          "title": "Profile Version",
          "type": "string"
        },
        "fact_id": {
          "description": "UUID of the cited candidate fact",
          "format": "uuid",
          "title": "Fact Id",
          "type": "string"
        }
      },
      "required": [
        "profile_version",
        "fact_id"
      ],
      "title": "CandidateEvidenceReference",
      "type": "object"
    },
    "DocumentType": {
      "description": "Type of generated document.",
      "enum": [
        "cv",
        "cover_letter"
      ],
      "title": "DocumentType",
      "type": "string"
    },
    "DraftClaim": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "claim_id": {
          "pattern": "^[a-z][a-z0-9_]{0,47}$",
          "title": "Claim Id",
          "type": "string"
        },
        "claim_subject": {
          "enum": [
            "candidate",
            "job"
          ],
          "title": "Claim Subject",
          "type": "string"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "evidence_reference": {
          "discriminator": {
            "mapping": {
              "candidate": "#/$defs/CandidateEvidenceReference",
              "job": "#/$defs/JobEvidenceReference"
            },
            "propertyName": "source_kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CandidateEvidenceReference"
            },
            {
              "$ref": "#/$defs/JobEvidenceReference"
            }
          ],
          "title": "Evidence Reference"
        },
        "source_field": {
          "enum": [
            "title",
            "organization",
            "start_date",
            "end_date",
            "skills",
            "metrics",
            "claims",
            "description_clean",
            "company_name_hint"
          ],
          "title": "Source Field",
          "type": "string"
        },
        "source_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Index"
        }
      },
      "required": [
        "claim_id",
        "claim_subject",
        "text",
        "evidence_reference",
        "source_field"
      ],
      "title": "DraftClaim",
      "type": "object"
    },
    "DraftEntry": {
      "additionalProperties": false,
      "description": "Ordered role/education entry or letter paragraph containing atomic claims.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "entry_id": {
          "pattern": "^[a-z][a-z0-9_]{0,47}$",
          "title": "Entry Id",
          "type": "string"
        },
        "claim_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,47}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Claim Ids",
          "type": "array"
        },
        "subjective_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,47}$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Subjective Ids",
          "type": "array"
        }
      },
      "required": [
        "entry_id"
      ],
      "title": "DraftEntry",
      "type": "object"
    },
    "DraftProvenance": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seal_id": {
          "title": "Seal Id",
          "type": "string"
        },
        "seal_hash": {
          "title": "Seal Hash",
          "type": "string"
        },
        "binding_hash": {
          "title": "Binding Hash",
          "type": "string"
        },
        "context_receipt_id": {
          "format": "uuid",
          "title": "Context Receipt Id",
          "type": "string"
        },
        "context_hash": {
          "title": "Context Hash",
          "type": "string"
        },
        "recipe_hash": {
          "title": "Recipe Hash",
          "type": "string"
        },
        "prompt_version": {
          "title": "Prompt Version",
          "type": "string"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "schema_digest": {
          "title": "Schema Digest",
          "type": "string"
        },
        "input_fingerprint": {
          "title": "Input Fingerprint",
          "type": "string"
        },
        "model_identifier": {
          "title": "Model Identifier",
          "type": "string"
        },
        "model_digest": {
          "title": "Model Digest",
          "type": "string"
        },
        "model_call_ref": {
          "format": "uuid",
          "title": "Model Call Ref",
          "type": "string"
        },
        "receipt_id": {
          "format": "uuid",
          "title": "Receipt Id",
          "type": "string"
        }
      },
      "required": [
        "seal_id",
        "seal_hash",
        "binding_hash",
        "context_receipt_id",
        "context_hash",
        "recipe_hash",
        "prompt_version",
        "schema_id",
        "schema_digest",
        "input_fingerprint",
        "model_identifier",
        "model_digest",
        "model_call_ref",
        "receipt_id"
      ],
      "title": "DraftProvenance",
      "type": "object"
    },
    "DraftReviewIssue": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "code": {
          "pattern": "^[a-z][a-z0-9_]{0,47}$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "default": "warning",
          "enum": [
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "uncertainty_kind": {
          "enum": [
            "semantic_review",
            "source_unknown",
            "source_uncertainty",
            "subjective",
            "translation",
            "upstream"
          ],
          "title": "Uncertainty Kind",
          "type": "string"
        },
        "affected_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,47}$",
            "type": "string"
          },
          "maxItems": 200,
          "title": "Affected Ids",
          "type": "array"
        },
        "source_references": {
          "items": {
            "discriminator": {
              "mapping": {
                "candidate": "#/$defs/CandidateEvidenceReference",
                "job": "#/$defs/JobEvidenceReference"
              },
              "propertyName": "source_kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/CandidateEvidenceReference"
              },
              {
                "$ref": "#/$defs/JobEvidenceReference"
              }
            ]
          },
          "maxItems": 100,
          "title": "Source References",
          "type": "array"
        },
        "requires_human_review": {
          "const": true,
          "default": true,
          "title": "Requires Human Review",
          "type": "boolean"
        },
        "upstream_warning": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upstream Warning"
        }
      },
      "required": [
        "code",
        "message",
        "uncertainty_kind"
      ],
      "title": "DraftReviewIssue",
      "type": "object"
    },
    "DraftSection": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "section_id": {
          "pattern": "^[a-z][a-z0-9_]{0,47}$",
          "title": "Section Id",
          "type": "string"
        },
        "heading_key": {
          "enum": [
            "summary",
            "experience",
            "education",
            "skills",
            "motivation",
            "opening",
            "closing"
          ],
          "title": "Heading Key",
          "type": "string"
        },
        "claim_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,47}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Claim Ids",
          "type": "array"
        },
        "subjective_ids": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,47}$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Subjective Ids",
          "type": "array"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/DraftEntry"
          },
          "maxItems": 40,
          "title": "Entries",
          "type": "array"
        }
      },
      "required": [
        "section_id",
        "heading_key"
      ],
      "title": "DraftSection",
      "type": "object"
    },
    "FrozenInputVersions": {
      "additionalProperties": false,
      "description": "Snapshot of exact input versions frozen when a generation request is claimed.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "posting_revision": {
          "description": "Job posting revision hash",
          "minLength": 1,
          "title": "Posting Revision",
          "type": "string"
        },
        "profile_version": {
          "description": "Candidate profile version",
          "minLength": 1,
          "title": "Profile Version",
          "type": "string"
        },
        "policy_version": {
          "description": "Search policy version",
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "template_version": {
          "description": "Document template version",
          "minLength": 1,
          "title": "Template Version",
          "type": "string"
        }
      },
      "required": [
        "posting_revision",
        "profile_version",
        "policy_version",
        "template_version"
      ],
      "title": "FrozenInputVersions",
      "type": "object"
    },
    "JobEvidenceReference": {
      "additionalProperties": false,
      "description": "Reference citing a specific job posting requirement or statement.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_kind": {
          "const": "job",
          "default": "job",
          "title": "Source Kind",
          "type": "string"
        },
        "posting_revision": {
          "description": "Content hash or revision ID of the posting",
          "minLength": 1,
          "title": "Posting Revision",
          "type": "string"
        },
        "field_path": {
          "description": "Path to the cited field (e.g. 'description', 'requirements')",
          "minLength": 1,
          "title": "Field Path",
          "type": "string"
        },
        "quotation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Direct supporting quotation from the source text",
          "title": "Quotation"
        },
        "source_span": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Character offsets of the cited passage in the field"
        }
      },
      "required": [
        "posting_revision",
        "field_path"
      ],
      "title": "JobEvidenceReference",
      "type": "object"
    },
    "PrecisionDate": {
      "additionalProperties": false,
      "description": "Date with explicit precision: day, month, or year.\n\nMonth precision '2021-05' stays as-is; no day is fabricated.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "value": {
          "description": "ISO date string matching the precision",
          "title": "Value",
          "type": "string"
        },
        "precision": {
          "enum": [
            "day",
            "month",
            "year"
          ],
          "title": "Precision",
          "type": "string"
        }
      },
      "required": [
        "value",
        "precision"
      ],
      "title": "PrecisionDate",
      "type": "object"
    },
    "ProtectedSourceValue": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "claim_id": {
          "pattern": "^[a-z][a-z0-9_]{0,47}$",
          "title": "Claim Id",
          "type": "string"
        },
        "source_field": {
          "title": "Source Field",
          "type": "string"
        },
        "original_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "$ref": "#/$defs/PrecisionDate"
            },
            {
              "type": "null"
            }
          ],
          "title": "Original Value"
        },
        "evidence_reference": {
          "discriminator": {
            "mapping": {
              "candidate": "#/$defs/CandidateEvidenceReference",
              "job": "#/$defs/JobEvidenceReference"
            },
            "propertyName": "source_kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CandidateEvidenceReference"
            },
            {
              "$ref": "#/$defs/JobEvidenceReference"
            }
          ],
          "title": "Evidence Reference"
        }
      },
      "required": [
        "claim_id",
        "source_field",
        "original_value",
        "evidence_reference"
      ],
      "title": "ProtectedSourceValue",
      "type": "object"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "description": "Character offsets within a source field.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start": {
          "description": "0-based start character index",
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "description": "0-based end character index (exclusive)",
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "SourceSpan",
      "type": "object"
    },
    "SubjectiveBlock": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "block_id": {
          "pattern": "^[a-z][a-z0-9_]{0,47}$",
          "title": "Block Id",
          "type": "string"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "requires_human_review": {
          "const": true,
          "default": true,
          "title": "Requires Human Review",
          "type": "boolean"
        }
      },
      "required": [
        "block_id",
        "text"
      ],
      "title": "SubjectiveBlock",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/DraftSection"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Sections",
      "type": "array"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/DraftClaim"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Claims",
      "type": "array"
    },
    "subjective_blocks": {
      "items": {
        "$ref": "#/$defs/SubjectiveBlock"
      },
      "maxItems": 20,
      "title": "Subjective Blocks",
      "type": "array"
    },
    "draft_id": {
      "format": "uuid",
      "title": "Draft Id",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "document_type": {
      "$ref": "#/$defs/DocumentType"
    },
    "document_version": {
      "title": "Document Version",
      "type": "string"
    },
    "target_language": {
      "enum": [
        "de",
        "en"
      ],
      "title": "Target Language",
      "type": "string"
    },
    "template_id": {
      "title": "Template Id",
      "type": "string"
    },
    "template_version": {
      "title": "Template Version",
      "type": "string"
    },
    "template_content_digest": {
      "title": "Template Content Digest",
      "type": "string"
    },
    "headings": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Headings",
      "type": "object"
    },
    "candidate_name": {
      "default": null,
      "title": "Candidate Name",
      "type": "null"
    },
    "protected_values": {
      "items": {
        "$ref": "#/$defs/ProtectedSourceValue"
      },
      "title": "Protected Values",
      "type": "array"
    },
    "review_issues": {
      "items": {
        "$ref": "#/$defs/DraftReviewIssue"
      },
      "title": "Review Issues",
      "type": "array"
    },
    "requires_human_review": {
      "const": true,
      "default": true,
      "title": "Requires Human Review",
      "type": "boolean"
    },
    "validation_status": {
      "const": "pending_gen04",
      "default": "pending_gen04",
      "title": "Validation Status",
      "type": "string"
    },
    "frozen_inputs": {
      "$ref": "#/$defs/FrozenInputVersions"
    },
    "provenance": {
      "$ref": "#/$defs/DraftProvenance"
    }
  },
  "required": [
    "sections",
    "claims",
    "draft_id",
    "request_id",
    "document_type",
    "document_version",
    "target_language",
    "template_id",
    "template_version",
    "template_content_digest",
    "headings",
    "protected_values",
    "review_issues",
    "frozen_inputs",
    "provenance"
  ],
  "title": "DraftDocumentV2",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-automation.local/schemas/v2/draft_document.schema.json"
}

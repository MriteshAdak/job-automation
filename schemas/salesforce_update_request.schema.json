{
  "additionalProperties": false,
  "description": "Request to update an existing record by known Salesforce Record ID.",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "call_id": {
      "description": "Caller-generated operation UUID",
      "format": "uuid",
      "title": "Call Id",
      "type": "string"
    },
    "object_name": {
      "description": "Target sObject API name",
      "title": "Object Name",
      "type": "string"
    },
    "record_id": {
      "description": "Target Salesforce Record ID",
      "maxLength": 18,
      "minLength": 15,
      "title": "Record Id",
      "type": "string"
    },
    "fields": {
      "additionalProperties": true,
      "description": "Fields to patch on record",
      "minProperties": 1,
      "title": "Fields",
      "type": "object"
    }
  },
  "required": [
    "object_name",
    "record_id",
    "fields"
  ],
  "title": "UpdateRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-automation.local/schemas/v1/salesforce_update_request.schema.json"
}

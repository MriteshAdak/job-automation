{
  "$defs": {
    "EmbeddingConfiguration": {
      "additionalProperties": false,
      "description": "Measured embedding model configuration, dimensions, and execution parameters.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "configuration_version": {
          "default": "v1",
          "title": "Configuration Version",
          "type": "string"
        },
        "model_identifier": {
          "description": "Model identifier or tag (e.g. nomic-embed-text)",
          "minLength": 1,
          "title": "Model Identifier",
          "type": "string"
        },
        "dimension": {
          "description": "Embedding vector dimension",
          "exclusiveMinimum": 0,
          "title": "Dimension",
          "type": "integer"
        },
        "model_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Immutable SHA-256 digest of model weights/manifest if verified",
          "title": "Model Digest"
        },
        "expected_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Expected model digest configured for drift detection",
          "title": "Expected Digest"
        },
        "verification_provenance": {
          "default": "model_02_recommendation",
          "description": "Origin of verification (e.g. 'model_02_recommendation', 'synthetic_fake')",
          "title": "Verification Provenance",
          "type": "string"
        },
        "runtime_version": {
          "default": "1.0",
          "minLength": 1,
          "title": "Runtime Version",
          "type": "string"
        },
        "provider_version": {
          "default": "1.0",
          "minLength": 1,
          "title": "Provider Version",
          "type": "string"
        },
        "document_prefix": {
          "default": "",
          "description": "Prefix prepended to document chunks before embedding (e.g. 'search_document: ')",
          "title": "Document Prefix",
          "type": "string"
        },
        "query_prefix": {
          "default": "",
          "description": "Prefix prepended to query text before embedding (e.g. 'search_query: ')",
          "title": "Query Prefix",
          "type": "string"
        },
        "output_affecting_options": {
          "additionalProperties": true,
          "description": "Options that affect numerical embedding output",
          "title": "Output Affecting Options",
          "type": "object"
        },
        "measurement_method": {
          "default": "character_ratio",
          "description": "Tokenizer or estimator method used for input measurement",
          "title": "Measurement Method",
          "type": "string"
        },
        "max_input_tokens": {
          "default": 512,
          "description": "Maximum tokens per single text chunk",
          "exclusiveMinimum": 0,
          "title": "Max Input Tokens",
          "type": "integer"
        },
        "max_batch_items": {
          "default": 32,
          "description": "Maximum items per embedding API call",
          "exclusiveMinimum": 0,
          "title": "Max Batch Items",
          "type": "integer"
        },
        "max_batch_bytes": {
          "default": 1048576,
          "description": "Maximum combined UTF-8 bytes per embedding batch",
          "exclusiveMinimum": 0,
          "title": "Max Batch Bytes",
          "type": "integer"
        },
        "model_02_report_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reference identifier or file path of MODEL-02 benchmark report",
          "title": "Model 02 Report Ref"
        },
        "model_02_report_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SHA-256 content hash of MODEL-02 benchmark report",
          "title": "Model 02 Report Hash"
        }
      },
      "required": [
        "model_identifier",
        "dimension"
      ],
      "title": "EmbeddingConfiguration",
      "type": "object"
    },
    "RetrievalSettings": {
      "additionalProperties": false,
      "description": "Validated settings governing keyword/semantic retrieval and reciprocal rank fusion.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "algorithm_version": {
          "default": "v1",
          "title": "Algorithm Version",
          "type": "string"
        },
        "query_format_version": {
          "default": "v1",
          "title": "Query Format Version",
          "type": "string"
        },
        "top_k": {
          "default": 8,
          "description": "Maximum number of optional primary facts admitted (0 is allowed)",
          "minimum": 0,
          "title": "Top K",
          "type": "integer"
        },
        "per_channel_limit": {
          "default": 20,
          "description": "Per-query candidate pool limit for each channel (keyword and semantic)",
          "exclusiveMinimum": 0,
          "title": "Per Channel Limit",
          "type": "integer"
        },
        "keyword_metric": {
          "default": "distinct_terms",
          "description": "Keyword scoring metric",
          "enum": [
            "distinct_terms",
            "bm25"
          ],
          "title": "Keyword Metric",
          "type": "string"
        },
        "semantic_metric": {
          "default": "cosine",
          "description": "Semantic similarity metric",
          "enum": [
            "cosine",
            "dot_product"
          ],
          "title": "Semantic Metric",
          "type": "string"
        },
        "fusion_method": {
          "const": "rrf",
          "default": "rrf",
          "description": "Rank fusion method (Reciprocal Rank Fusion)",
          "title": "Fusion Method",
          "type": "string"
        },
        "rrf_k": {
          "default": 60,
          "description": "RRF smoothing constant k in sum(1 / (k + rank))",
          "exclusiveMinimum": 0,
          "title": "Rrf K",
          "type": "integer"
        },
        "multi_query_aggregation": {
          "default": "max",
          "description": "Aggregation method across multiple requirement queries",
          "enum": [
            "max",
            "sum"
          ],
          "title": "Multi Query Aggregation",
          "type": "string"
        },
        "tie_break_order": {
          "description": "Ordered tie-break criteria for equal fused scores",
          "items": {
            "type": "string"
          },
          "title": "Tie Break Order",
          "type": "array"
        },
        "strict_parents": {
          "default": false,
          "description": "If True, missing/restricted optional parent raises permission error",
          "title": "Strict Parents",
          "type": "boolean"
        },
        "semantic_threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional minimum semantic similarity cutoff; None initially",
          "title": "Semantic Threshold"
        },
        "max_queries": {
          "default": 20,
          "description": "Maximum number of requirement queries processed",
          "exclusiveMinimum": 0,
          "title": "Max Queries",
          "type": "integer"
        },
        "max_query_chars": {
          "default": 500,
          "description": "Maximum character length per requirement query",
          "exclusiveMinimum": 0,
          "title": "Max Query Chars",
          "type": "integer"
        }
      },
      "title": "RetrievalSettings",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Configuration settings for GEN-02 input freezing and context assembly.",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "candidate_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Id"
    },
    "supported_languages": {
      "items": {
        "type": "string"
      },
      "title": "Supported Languages",
      "type": "array"
    },
    "supported_document_types": {
      "items": {
        "type": "string"
      },
      "title": "Supported Document Types",
      "type": "array"
    },
    "default_template_id": {
      "default": "default_template",
      "title": "Default Template Id",
      "type": "string"
    },
    "default_template_version": {
      "default": "v1",
      "title": "Default Template Version",
      "type": "string"
    },
    "default_model_identifier": {
      "default": "gemini-1.5-pro",
      "title": "Default Model Identifier",
      "type": "string"
    },
    "default_context_limit": {
      "default": 8192,
      "title": "Default Context Limit",
      "type": "integer"
    },
    "default_output_reserve": {
      "default": 512,
      "title": "Default Output Reserve",
      "type": "integer"
    },
    "default_safety_allowance": {
      "default": 64,
      "title": "Default Safety Allowance",
      "type": "integer"
    },
    "require_exact_measurement": {
      "default": false,
      "title": "Require Exact Measurement",
      "type": "boolean"
    },
    "retrieval_settings": {
      "$ref": "#/$defs/RetrievalSettings"
    },
    "embedding_config": {
      "anyOf": [
        {
          "$ref": "#/$defs/EmbeddingConfiguration"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "default_instruction_text_cv": {
      "default": "Tailor the candidate CV directly to the target job posting.",
      "title": "Default Instruction Text Cv",
      "type": "string"
    },
    "default_instruction_text_cover_letter": {
      "default": "Draft a persuasive, professional cover letter grounded in verified candidate evidence.",
      "title": "Default Instruction Text Cover Letter",
      "type": "string"
    }
  },
  "title": "GenerationInputSettings",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-automation.local/schemas/v1/generation_input_settings.schema.json"
}

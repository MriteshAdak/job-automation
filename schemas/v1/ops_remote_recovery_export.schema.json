{
  "$defs": {
    "RemoteCompleteness": {
      "description": "Completeness state of remote recovery export.",
      "enum": [
        "complete",
        "partial",
        "incomplete",
        "local_only_absent_sf04"
      ],
      "title": "RemoteCompleteness",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Candidate-owned Salesforce export package for disaster recovery.",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scan_id": {
      "description": "Stable identifier for the export scan",
      "title": "Scan Id",
      "type": "string"
    },
    "start_time": {
      "description": "UTC datetime with +00:00 offset",
      "format": "date-time",
      "title": "Start Time",
      "type": "string"
    },
    "end_time": {
      "description": "UTC datetime with +00:00 offset",
      "format": "date-time",
      "title": "End Time",
      "type": "string"
    },
    "org_id": {
      "title": "Org Id",
      "type": "string"
    },
    "object_coverage": {
      "items": {
        "type": "string"
      },
      "title": "Object Coverage",
      "type": "array"
    },
    "expected_count": {
      "default": 0,
      "minimum": 0,
      "title": "Expected Count",
      "type": "integer"
    },
    "read_count": {
      "default": 0,
      "minimum": 0,
      "title": "Read Count",
      "type": "integer"
    },
    "saved_count": {
      "default": 0,
      "minimum": 0,
      "title": "Saved Count",
      "type": "integer"
    },
    "skipped_count": {
      "default": 0,
      "minimum": 0,
      "title": "Skipped Count",
      "type": "integer"
    },
    "missing_fields": {
      "items": {
        "type": "string"
      },
      "title": "Missing Fields",
      "type": "array"
    },
    "per_record_tokens": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Per Record Tokens",
      "type": "object"
    },
    "completeness_status": {
      "$ref": "#/$defs/RemoteCompleteness",
      "default": "local_only_absent_sf04"
    },
    "checksum": {
      "default": "",
      "title": "Checksum",
      "type": "string"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    }
  },
  "required": [
    "scan_id",
    "start_time",
    "end_time",
    "org_id"
  ],
  "title": "RemoteRecoveryExport",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-automation.local/schemas/v1/ops_remote_recovery_export.schema.json"
}

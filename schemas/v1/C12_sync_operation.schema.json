{
  "$defs": {
    "AssessmentDisposition": {
      "description": "Assessment outcome disposition. Authority: local assessment.",
      "enum": [
        "eligible",
        "review",
        "rejected"
      ],
      "title": "AssessmentDisposition",
      "type": "string"
    },
    "ClassifiedError": {
      "additionalProperties": false,
      "description": "Classified operational or domain error.\n\nDistinguishes recoverable failures from permanent errors and maps\nto the system error taxonomy without arbitrary tool or shell authority.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/ErrorCategory"
        },
        "message": {
          "description": "Safe diagnostic message without credentials or tokens",
          "title": "Message",
          "type": "string"
        },
        "recoverable": {
          "description": "Whether this error category is eligible for bounded retry",
          "title": "Recoverable",
          "type": "boolean"
        },
        "field_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional field path if the error pertains to a specific field",
          "title": "Field Path"
        },
        "details": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Safe non-sensitive contextual details",
          "title": "Details"
        }
      },
      "required": [
        "category",
        "message",
        "recoverable"
      ],
      "title": "ClassifiedError",
      "type": "object"
    },
    "ErrorCategory": {
      "description": "Classified error category for failure handling and recovery.",
      "enum": [
        "validation",
        "missing_configuration",
        "permission",
        "authentication",
        "rate_limit",
        "transient_network",
        "transient_service",
        "context_budget",
        "model_output",
        "capacity",
        "unsupported_input"
      ],
      "title": "ErrorCategory",
      "type": "string"
    },
    "PostingAvailability": {
      "description": "Posting availability status. Authority: source observations.",
      "enum": [
        "active",
        "not_seen",
        "unavailable",
        "unknown"
      ],
      "title": "PostingAvailability",
      "type": "string"
    },
    "SyncOperationState": {
      "description": "Salesforce sync operation state. Authority: local outbox/gateway.",
      "enum": [
        "pending",
        "running",
        "retry_wait",
        "succeeded",
        "failed"
      ],
      "title": "SyncOperationState",
      "type": "string"
    },
    "SyncPayload": {
      "additionalProperties": false,
      "description": "Machine-owned fields synchronized to Salesforce.\n\nStrictly excludes candidate-owned fields (e.g. application progress,\ncandidate notes, follow-up dates, manual overrides).",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "canonical_job_id": {
          "description": "Target canonical job UUID",
          "format": "uuid",
          "title": "Canonical Job Id",
          "type": "string"
        },
        "job_title": {
          "description": "Latest normalized job title",
          "minLength": 1,
          "title": "Job Title",
          "type": "string"
        },
        "company_name": {
          "description": "Resolved employer name",
          "minLength": 1,
          "title": "Company Name",
          "type": "string"
        },
        "availability": {
          "$ref": "#/$defs/PostingAvailability",
          "description": "Posting availability"
        },
        "assessment_disposition": {
          "$ref": "#/$defs/AssessmentDisposition",
          "description": "Machine assessment disposition"
        },
        "relevance_score": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Machine relevance score",
          "title": "Relevance Score"
        },
        "score_scale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Score scale",
          "title": "Score Scale"
        },
        "assessment_reasons": {
          "description": "Summary explanation of assessment",
          "title": "Assessment Reasons",
          "type": "string"
        },
        "source_urls": {
          "description": "Observed source posting URLs",
          "items": {
            "type": "string"
          },
          "title": "Source Urls",
          "type": "array"
        },
        "last_evaluated_at": {
          "description": "Timestamp of the evaluated assessment",
          "format": "date-time",
          "title": "Last Evaluated At",
          "type": "string"
        }
      },
      "required": [
        "canonical_job_id",
        "job_title",
        "company_name",
        "availability",
        "assessment_disposition",
        "assessment_reasons",
        "last_evaluated_at"
      ],
      "title": "SyncPayload",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "C12 Salesforce Sync Operation.\n\nRepresents a queued or executed write operation to Salesforce.\nSequenced and fingerprinted to prevent stale writes.",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "operation_id": {
      "description": "Unique operation UUID",
      "format": "uuid",
      "title": "Operation Id",
      "type": "string"
    },
    "canonical_job_id": {
      "description": "Associated canonical job UUID",
      "format": "uuid",
      "title": "Canonical Job Id",
      "type": "string"
    },
    "payload_version": {
      "description": "Sequential or timestamped version token of this update",
      "minLength": 1,
      "title": "Payload Version",
      "type": "string"
    },
    "payload_fingerprint": {
      "description": "Content hash of the locally owned payload",
      "minLength": 1,
      "title": "Payload Fingerprint",
      "type": "string"
    },
    "locally_owned_payload": {
      "$ref": "#/$defs/SyncPayload",
      "description": "Strictly machine-owned fields to push to Salesforce"
    },
    "attempt_count": {
      "default": 0,
      "description": "Number of delivery attempts made",
      "minimum": 0,
      "title": "Attempt Count",
      "type": "integer"
    },
    "max_attempts": {
      "default": 3,
      "description": "Maximum retry attempts permitted",
      "exclusiveMinimum": 0,
      "title": "Max Attempts",
      "type": "integer"
    },
    "state": {
      "$ref": "#/$defs/SyncOperationState",
      "default": "pending",
      "description": "Current outbox operation state"
    },
    "remote_record_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Salesforce Job__c record ID once created or acknowledged",
      "title": "Remote Record Id"
    },
    "remote_acknowledged_at": {
      "anyOf": [
        {
          "description": "UTC datetime with +00:00 offset",
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Timestamp when Salesforce acknowledged the upsert",
      "title": "Remote Acknowledged At"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClassifiedError"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Error details from the most recent failed attempt"
    }
  },
  "required": [
    "operation_id",
    "canonical_job_id",
    "payload_version",
    "payload_fingerprint",
    "locally_owned_payload"
  ],
  "title": "SyncOperation",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-automation.local/schemas/v1/C12_sync_operation.schema.json"
}

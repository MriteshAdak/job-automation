{
  "additionalProperties": false,
  "description": "Audit record for a bounded execution attempt converting a single format.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "attempt_id": {
      "format": "uuid",
      "title": "Attempt Id",
      "type": "string"
    },
    "intent_id": {
      "format": "uuid",
      "title": "Intent Id",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "attempt_number": {
      "minimum": 1,
      "title": "Attempt Number",
      "type": "integer"
    },
    "format": {
      "enum": [
        "docx",
        "pdf"
      ],
      "title": "Format",
      "type": "string"
    },
    "staging_dir": {
      "title": "Staging Dir",
      "type": "string"
    },
    "started_at": {
      "description": "UTC datetime with +00:00 offset",
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "completed_at": {
      "anyOf": [
        {
          "description": "UTC datetime with +00:00 offset",
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "status": {
      "default": "started",
      "enum": [
        "started",
        "completed",
        "failed",
        "timed_out"
      ],
      "title": "Status",
      "type": "string"
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exit Code"
    },
    "duration_ms": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Ms"
    },
    "error_json": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Json"
    }
  },
  "required": [
    "intent_id",
    "request_id",
    "attempt_number",
    "format",
    "staging_dir",
    "started_at"
  ],
  "title": "RenderAttempt",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-automation.local/schemas/v1/render_attempt.schema.json"
}
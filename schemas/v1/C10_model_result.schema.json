{
  "$defs": {
    "ClassifiedError": {
      "additionalProperties": false,
      "description": "Classified operational or domain error.\n\nDistinguishes recoverable failures from permanent errors and maps\nto the system error taxonomy without arbitrary tool or shell authority.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/ErrorCategory"
        },
        "message": {
          "description": "Safe diagnostic message without credentials or tokens",
          "title": "Message",
          "type": "string"
        },
        "recoverable": {
          "description": "Whether this error category is eligible for bounded retry",
          "title": "Recoverable",
          "type": "boolean"
        },
        "field_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional field path if the error pertains to a specific field",
          "title": "Field Path"
        },
        "details": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Safe non-sensitive contextual details",
          "title": "Details"
        }
      },
      "required": [
        "category",
        "message",
        "recoverable"
      ],
      "title": "ClassifiedError",
      "type": "object"
    },
    "ErrorCategory": {
      "description": "Classified error category for failure handling and recovery.",
      "enum": [
        "validation",
        "missing_configuration",
        "permission",
        "authentication",
        "rate_limit",
        "transient_network",
        "transient_service",
        "context_budget",
        "model_output",
        "capacity",
        "unsupported_input"
      ],
      "title": "ErrorCategory",
      "type": "string"
    },
    "TokenUsage": {
      "additionalProperties": false,
      "description": "Token usage metrics. Null values represent unknown or unmeasured metrics.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "prompt_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Tokens"
        },
        "completion_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completion Tokens"
        },
        "total_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Tokens"
        }
      },
      "title": "TokenUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "C10 Model Result.\n\nStandardized output from local model execution with timing and error classification.",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "call_id": {
      "description": "UUID linking to the corresponding ModelCall",
      "format": "uuid",
      "title": "Call Id",
      "type": "string"
    },
    "model_identifier": {
      "description": "Model that executed the call",
      "minLength": 1,
      "title": "Model Identifier",
      "type": "string"
    },
    "model_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Digest of model weights",
      "title": "Model Digest"
    },
    "output_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Raw text generated by the model; null on error",
      "title": "Output Text"
    },
    "parsed_output": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Parsed structured JSON output if applicable",
      "title": "Parsed Output"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClassifiedError"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Classified error if execution failed"
    },
    "latency_ms": {
      "description": "Execution duration in milliseconds",
      "minimum": 0.0,
      "title": "Latency Ms",
      "type": "number"
    },
    "token_usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/TokenUsage"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Token usage statistics if provided by the model service"
    }
  },
  "required": [
    "call_id",
    "model_identifier",
    "latency_ms"
  ],
  "title": "ModelResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-automation.local/schemas/v1/C10_model_result.schema.json"
}

{
  "$defs": {
    "AttemptSummary": {
      "additionalProperties": false,
      "description": "Summary of a single HTTP attempt during a gateway operation.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "attempt_number": {
          "description": "1-based attempt sequence index",
          "minimum": 1,
          "title": "Attempt Number",
          "type": "integer"
        },
        "purpose": {
          "description": "Purpose of attempt (e.g. token_acquisition, resource_request)",
          "title": "Purpose",
          "type": "string"
        },
        "http_status": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "HTTP response status code if response received",
          "title": "Http Status"
        },
        "duration_ms": {
          "description": "Observed roundtrip duration in milliseconds",
          "minimum": 0.0,
          "title": "Duration Ms",
          "type": "number"
        },
        "safe_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Allowlisted safe status/error code",
          "title": "Safe Code"
        },
        "uncertain_transmission": {
          "default": false,
          "description": "Whether request transmission to Salesforce was uncertain (e.g. timeout after send)",
          "title": "Uncertain Transmission",
          "type": "boolean"
        }
      },
      "required": [
        "attempt_number",
        "purpose",
        "duration_ms"
      ],
      "title": "AttemptSummary",
      "type": "object"
    },
    "ClassifiedError": {
      "additionalProperties": false,
      "description": "Classified operational or domain error.\n\nDistinguishes recoverable failures from permanent errors and maps\nto the system error taxonomy without arbitrary tool or shell authority.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/ErrorCategory"
        },
        "message": {
          "description": "Safe diagnostic message without credentials or tokens",
          "title": "Message",
          "type": "string"
        },
        "recoverable": {
          "description": "Whether this error category is eligible for bounded retry",
          "title": "Recoverable",
          "type": "boolean"
        },
        "field_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional field path if the error pertains to a specific field",
          "title": "Field Path"
        },
        "details": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Safe non-sensitive contextual details",
          "title": "Details"
        }
      },
      "required": [
        "category",
        "message",
        "recoverable"
      ],
      "title": "ClassifiedError",
      "type": "object"
    },
    "ErrorCategory": {
      "description": "Classified error category for failure handling and recovery.",
      "enum": [
        "validation",
        "missing_configuration",
        "permission",
        "authentication",
        "rate_limit",
        "transient_network",
        "transient_service",
        "context_budget",
        "model_output",
        "capacity",
        "unsupported_input"
      ],
      "title": "ErrorCategory",
      "type": "string"
    },
    "OperationKind": {
      "description": "Supported typed Salesforce operations.",
      "enum": [
        "check_connection",
        "get_limits",
        "describe_object",
        "get_record",
        "query_page",
        "upsert_by_external_id",
        "update_record"
      ],
      "title": "OperationKind",
      "type": "string"
    },
    "RecoveryAction": {
      "description": "Actionable guidance for failure resolution.",
      "enum": [
        "none",
        "retry_later",
        "reauthorize",
        "reconcile",
        "fix_configuration"
      ],
      "title": "RecoveryAction",
      "type": "string"
    },
    "RemoteOutcome": {
      "description": "Observed state of remote record mutation.",
      "enum": [
        "not_sent",
        "rejected",
        "unknown",
        "acknowledged"
      ],
      "title": "RemoteOutcome",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Structured failure representation for gateway operations.",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "error": {
      "$ref": "#/$defs/ClassifiedError",
      "description": "Classified system error"
    },
    "safe_provider_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Allowlisted Salesforce error code",
      "title": "Safe Provider Code"
    },
    "http_status": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "HTTP status code if available",
      "title": "Http Status"
    },
    "operation_kind": {
      "$ref": "#/$defs/OperationKind",
      "description": "Gateway operation kind that failed"
    },
    "remote_outcome": {
      "$ref": "#/$defs/RemoteOutcome",
      "description": "Observed mutation outcome on Salesforce"
    },
    "recovery_action": {
      "$ref": "#/$defs/RecoveryAction",
      "description": "Actionable recovery instruction"
    },
    "retry_not_before": {
      "anyOf": [
        {
          "description": "UTC datetime with +00:00 offset",
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Server-directed or backoff wait ceiling",
      "title": "Retry Not Before"
    },
    "exhausted_budget": {
      "default": false,
      "description": "Whether call budget or retry count was exhausted",
      "title": "Exhausted Budget",
      "type": "boolean"
    },
    "attempts": {
      "description": "Audit trace of HTTP attempts made",
      "items": {
        "$ref": "#/$defs/AttemptSummary"
      },
      "title": "Attempts",
      "type": "array"
    }
  },
  "required": [
    "error",
    "operation_kind",
    "remote_outcome",
    "recovery_action"
  ],
  "title": "GatewayFailure",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-automation.local/schemas/v1/salesforce_gateway_failure.schema.json"
}

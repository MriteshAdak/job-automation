{
  "$defs": {
    "ExportFileEntry": {
      "additionalProperties": false,
      "description": "Entry describing a single data file within a portable export package.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "relative_path": {
          "description": "Relative path within the export package",
          "title": "Relative Path",
          "type": "string"
        },
        "size_bytes": {
          "description": "Exact file size in bytes",
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "sha256": {
          "description": "SHA-256 hex digest of file contents",
          "title": "Sha256",
          "type": "string"
        },
        "record_count": {
          "description": "Number of logical records in the file",
          "minimum": 0,
          "title": "Record Count",
          "type": "integer"
        }
      },
      "required": [
        "relative_path",
        "size_bytes",
        "sha256",
        "record_count"
      ],
      "title": "ExportFileEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Manifest describing a completed candidate-owned data export package.",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "format_version": {
      "default": "1.0",
      "description": "Export format specification version",
      "title": "Format Version",
      "type": "string"
    },
    "export_id": {
      "description": "Unique export identifier",
      "format": "uuid",
      "title": "Export Id",
      "type": "string"
    },
    "scan_id": {
      "description": "Scan identifier binding multiple pages/steps",
      "title": "Scan Id",
      "type": "string"
    },
    "org_id": {
      "description": "Source Salesforce organization ID",
      "title": "Org Id",
      "type": "string"
    },
    "api_version": {
      "description": "REST API version used for export",
      "title": "Api Version",
      "type": "string"
    },
    "mapping_version": {
      "description": "SyncMappingConfig version",
      "title": "Mapping Version",
      "type": "string"
    },
    "mapping_hash": {
      "description": "SHA-256 hash of sync mapping config",
      "title": "Mapping Hash",
      "type": "string"
    },
    "metadata_digest": {
      "default": "",
      "description": "Digest of verified project metadata",
      "title": "Metadata Digest",
      "type": "string"
    },
    "start_time": {
      "description": "UTC timestamp when export scan started",
      "format": "date-time",
      "title": "Start Time",
      "type": "string"
    },
    "end_time": {
      "description": "UTC timestamp when export completed",
      "format": "date-time",
      "title": "End Time",
      "type": "string"
    },
    "capture_scope": {
      "default": "project_candidate_data",
      "description": "Declared scope of export",
      "title": "Capture Scope",
      "type": "string"
    },
    "expected_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "description": "Expected counts per entity",
      "title": "Expected Counts",
      "type": "object"
    },
    "read_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "description": "Records read per entity",
      "title": "Read Counts",
      "type": "object"
    },
    "saved_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "description": "Records successfully saved per entity",
      "title": "Saved Counts",
      "type": "object"
    },
    "skipped_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "description": "Records skipped per entity",
      "title": "Skipped Counts",
      "type": "object"
    },
    "error_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "description": "Errors encountered per entity",
      "title": "Error Counts",
      "type": "object"
    },
    "missing_fields": {
      "description": "Required candidate fields missing from org",
      "items": {
        "type": "string"
      },
      "title": "Missing Fields",
      "type": "array"
    },
    "pagination_completed": {
      "default": true,
      "description": "True if all pages were traversed without truncation",
      "title": "Pagination Completed",
      "type": "boolean"
    },
    "completeness_status": {
      "default": "complete",
      "description": "Completeness status: complete, partial, incomplete, local_only_absent_sf04",
      "title": "Completeness Status",
      "type": "string"
    },
    "omissions": {
      "description": "Explicit omissions or exclusions",
      "items": {
        "type": "string"
      },
      "title": "Omissions",
      "type": "array"
    },
    "files": {
      "description": "Files contained in package",
      "items": {
        "$ref": "#/$defs/ExportFileEntry"
      },
      "title": "Files",
      "type": "array"
    },
    "source_tokens": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Per-job SystemModstamp tokens for conflict detection",
      "title": "Source Tokens",
      "type": "object"
    },
    "notes": {
      "default": "",
      "description": "Operator notes and diagnostic summary",
      "title": "Notes",
      "type": "string"
    }
  },
  "required": [
    "scan_id",
    "org_id",
    "api_version",
    "mapping_version",
    "mapping_hash",
    "start_time",
    "end_time"
  ],
  "title": "ExportManifest",
  "type": "object"
}

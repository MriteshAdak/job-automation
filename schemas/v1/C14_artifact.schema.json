{
  "$defs": {
    "DocumentApproval": {
      "description": "Document approval status. Authority: candidate; generation never approves.",
      "enum": [
        "draft",
        "approved",
        "superseded"
      ],
      "title": "DocumentApproval",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "C14 Physical Artifact.\n\nRepresents a rendered file (DOCX or PDF) stored locally and optionally delivered\nto Salesforce Files. Separates delivery status from candidate human approval.",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "artifact_id": {
      "description": "Unique artifact UUID",
      "format": "uuid",
      "title": "Artifact Id",
      "type": "string"
    },
    "request_id": {
      "description": "Parent GenerationRequest UUID",
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "artifact_version": {
      "default": 1,
      "description": "Sequential artifact version",
      "minimum": 1,
      "title": "Artifact Version",
      "type": "integer"
    },
    "format": {
      "description": "File format: docx or pdf",
      "enum": [
        "docx",
        "pdf"
      ],
      "title": "Format",
      "type": "string"
    },
    "local_path": {
      "description": "Absolute local filesystem path to artifact",
      "minLength": 1,
      "title": "Local Path",
      "type": "string"
    },
    "content_hash": {
      "description": "SHA-256 hash of the rendered file",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "size_bytes": {
      "description": "Size in bytes",
      "minimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    },
    "remote_file_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Salesforce ContentVersion or ContentDocument ID once delivered",
      "title": "Remote File Id"
    },
    "delivery_status": {
      "default": "local_only",
      "description": "Remote delivery state",
      "enum": [
        "local_only",
        "upload_pending",
        "delivered"
      ],
      "title": "Delivery Status",
      "type": "string"
    },
    "approval_status": {
      "$ref": "#/$defs/DocumentApproval",
      "default": "draft",
      "description": "Human approval status: draft, approved, or superseded"
    },
    "reconciliation_marker": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Unique idempotency marker for safe Salesforce upload reconciliation",
      "title": "Reconciliation Marker"
    },
    "created_at": {
      "description": "Artifact creation timestamp (UTC)",
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "request_id",
    "format",
    "local_path",
    "content_hash",
    "size_bytes",
    "created_at"
  ],
  "title": "Artifact",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-automation.local/schemas/v1/C14_artifact.schema.json"
}

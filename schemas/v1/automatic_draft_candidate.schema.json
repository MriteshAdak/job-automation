{
  "$defs": {
    "AssessmentDisposition": {
      "description": "Assessment outcome disposition. Authority: local assessment.",
      "enum": [
        "eligible",
        "review",
        "rejected"
      ],
      "title": "AssessmentDisposition",
      "type": "string"
    },
    "CandidateEligibility": {
      "additionalProperties": false,
      "description": "Explicit eligibility facts confirmed by the candidate.\n\nDistinct from desired job preferences. An absent proficiency is unknown,\nnot absent capability.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "work_authorization_countries": {
          "description": "ISO 3166-1 alpha-2 country codes where candidate is authorized to work",
          "items": {
            "type": "string"
          },
          "title": "Work Authorization Countries",
          "type": "array"
        },
        "target_locations": {
          "description": "Locations candidate is eligible/willing to work in",
          "items": {
            "type": "string"
          },
          "title": "Target Locations",
          "type": "array"
        },
        "remote_eligible": {
          "default": true,
          "description": "Whether candidate is eligible for remote work",
          "title": "Remote Eligible",
          "type": "boolean"
        },
        "min_salary": {
          "anyOf": [
            {
              "$ref": "#/$defs/MoneyAmount"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minimum acceptable compensation; null means unspecified/unknown"
        },
        "language_proficiencies": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Language codes (e.g. 'de', 'en') mapped to CEFR levels (e.g. 'C1', 'B2') or descriptions",
          "title": "Language Proficiencies",
          "type": "object"
        }
      },
      "title": "CandidateEligibility",
      "type": "object"
    },
    "CandidateFact": {
      "additionalProperties": false,
      "description": "Individual approved evidence record.\n\nTraced to specific parent roles/projects, dated with explicit precision,\nand tagged with allowed uses (e.g. cv, cover_letter, assessment).",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "fact_id": {
          "description": "Unique ID for this candidate fact",
          "format": "uuid",
          "title": "Fact Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceFactKind",
          "description": "Category of evidence fact"
        },
        "parent_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Parent role or project ID if hierarchical",
          "title": "Parent Id"
        },
        "title": {
          "description": "Fact headline (e.g. role title or degree)",
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "organization": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Employer, institution, or client organization",
          "title": "Organization"
        },
        "start_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrecisionDate"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Start date with explicit precision"
        },
        "end_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrecisionDate"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "End date with explicit precision; null if ongoing/present"
        },
        "claims": {
          "description": "Specific factual claims / accomplishments",
          "items": {
            "type": "string"
          },
          "title": "Claims",
          "type": "array"
        },
        "skills": {
          "description": "Demonstrated skills / technologies",
          "items": {
            "type": "string"
          },
          "title": "Skills",
          "type": "array"
        },
        "metrics": {
          "description": "Verified quantitative metrics / achievements",
          "items": {
            "type": "string"
          },
          "title": "Metrics",
          "type": "array"
        },
        "provenance": {
          "description": "Source reference (e.g. 'contract-2023', 'cv_v2_import')",
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        },
        "allowed_uses": {
          "description": "Permitted contexts for this fact",
          "items": {
            "type": "string"
          },
          "title": "Allowed Uses",
          "type": "array"
        }
      },
      "required": [
        "fact_id",
        "kind",
        "title",
        "provenance"
      ],
      "title": "CandidateFact",
      "type": "object"
    },
    "CompensationProvenance": {
      "description": "Origin of compensation data.",
      "enum": [
        "employer_provided",
        "estimated",
        "unknown"
      ],
      "title": "CompensationProvenance",
      "type": "string"
    },
    "EmploymentType": {
      "description": "Employment arrangement type.",
      "enum": [
        "full_time",
        "part_time",
        "contract",
        "internship",
        "temporary",
        "unknown"
      ],
      "title": "EmploymentType",
      "type": "string"
    },
    "EvidenceFactKind": {
      "description": "Kind of candidate evidence fact.",
      "enum": [
        "employment",
        "education",
        "certification",
        "skill",
        "language",
        "project",
        "publication",
        "award",
        "volunteer",
        "other"
      ],
      "title": "EvidenceFactKind",
      "type": "string"
    },
    "JobCompensation": {
      "additionalProperties": false,
      "description": "Compensation details retaining currency, period, and provenance.\n\nNo implicit annualization or cross-currency conversion is performed.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "min_amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minimum compensation amount",
          "title": "Min Amount"
        },
        "max_amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum compensation amount",
          "title": "Max Amount"
        },
        "currency": {
          "default": "EUR",
          "maxLength": 3,
          "minLength": 3,
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "period": {
          "$ref": "#/$defs/SalaryPeriod",
          "default": "yearly"
        },
        "is_gross": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "True if gross, False if net, None if unknown",
          "title": "Is Gross"
        },
        "provenance": {
          "$ref": "#/$defs/CompensationProvenance",
          "default": "unknown",
          "description": "Whether compensation is employer-provided or estimated"
        }
      },
      "title": "JobCompensation",
      "type": "object"
    },
    "MoneyAmount": {
      "additionalProperties": false,
      "description": "Monetary amount with explicit currency.\n\nA null amount means unknown, not zero. An explicit zero means zero.\nCurrency uses ISO 4217 three-letter codes.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "description": "Monetary value; null at parent level means unknown",
          "title": "Amount"
        },
        "currency": {
          "description": "ISO 4217 currency code",
          "maxLength": 3,
          "minLength": 3,
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "MoneyAmount",
      "type": "object"
    },
    "NormalizedPosting": {
      "additionalProperties": false,
      "description": "C06 Normalized Posting.\n\nUniform schema produced by common normalization. Missing title or usable\nsource identity produces a validation issue, never a fabricated replacement.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_key": {
          "$ref": "#/$defs/SourceKey",
          "description": "Scoped source identity"
        },
        "normalizer_version": {
          "description": "Version of the normalizer used",
          "minLength": 1,
          "title": "Normalizer Version",
          "type": "string"
        },
        "raw_reference": {
          "description": "Reference to raw posting data",
          "minLength": 1,
          "title": "Raw Reference",
          "type": "string"
        },
        "raw_content_hash": {
          "description": "SHA-256 hash of raw input content",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Raw Content Hash",
          "type": "string"
        },
        "company_name_hint": {
          "description": "Extracted company name hint",
          "minLength": 1,
          "title": "Company Name Hint",
          "type": "string"
        },
        "company_id_hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Provider-scoped company/employer ID if present",
          "title": "Company Id Hint"
        },
        "title": {
          "description": "Job title; required",
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description_clean": {
          "description": "Cleaned, HTML-stripped description text",
          "minLength": 1,
          "title": "Description Clean",
          "type": "string"
        },
        "source_url": {
          "description": "Original posting source URL",
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "application_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Direct application URL if distinct from source URL",
          "title": "Application Url"
        },
        "locations": {
          "description": "Structured locations preserving original text",
          "items": {
            "$ref": "#/$defs/StructuredLocation"
          },
          "title": "Locations",
          "type": "array"
        },
        "workplace_type": {
          "$ref": "#/$defs/WorkplaceType",
          "default": "unknown",
          "description": "Onsite, hybrid, remote, or unknown"
        },
        "remote_eligibility_restrictions": {
          "description": "Geographic restrictions on remote eligibility (e.g. ['DE', 'EU'])",
          "items": {
            "type": "string"
          },
          "title": "Remote Eligibility Restrictions",
          "type": "array"
        },
        "employment_type": {
          "$ref": "#/$defs/EmploymentType",
          "default": "unknown",
          "description": "Full-time, part-time, contract, internship, etc."
        },
        "compensation": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobCompensation"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Structured compensation; null if unstated in advert"
        },
        "advert_language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Detected or declared advert language code (e.g. 'de', 'en')",
          "title": "Advert Language"
        },
        "source_published_at": {
          "anyOf": [
            {
              "description": "UTC datetime with +00:00 offset",
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Publication timestamp stated by the source (UTC)",
          "title": "Source Published At"
        },
        "source_updated_at": {
          "anyOf": [
            {
              "description": "UTC datetime with +00:00 offset",
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Last update timestamp stated by the source (UTC)",
          "title": "Source Updated At"
        },
        "source_deadline_at": {
          "anyOf": [
            {
              "description": "UTC datetime with +00:00 offset",
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Application closing date stated by the source; null if absent",
          "title": "Source Deadline At"
        },
        "observed_at": {
          "description": "Locally observed timestamp when this posting was fetched/processed",
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "field_provenance": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Provenance mapping for individual fields (e.g. {'title': 'raw.job_title'})",
          "title": "Field Provenance",
          "type": "object"
        }
      },
      "required": [
        "source_key",
        "normalizer_version",
        "raw_reference",
        "raw_content_hash",
        "company_name_hint",
        "title",
        "description_clean",
        "source_url",
        "observed_at"
      ],
      "title": "NormalizedPosting",
      "type": "object"
    },
    "PostingAvailability": {
      "description": "Posting availability status. Authority: source observations.",
      "enum": [
        "active",
        "not_seen",
        "unavailable",
        "unknown"
      ],
      "title": "PostingAvailability",
      "type": "string"
    },
    "PrecisionDate": {
      "additionalProperties": false,
      "description": "Date with explicit precision: day, month, or year.\n\nMonth precision '2021-05' stays as-is; no day is fabricated.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "value": {
          "description": "ISO date string matching the precision",
          "title": "Value",
          "type": "string"
        },
        "precision": {
          "enum": [
            "day",
            "month",
            "year"
          ],
          "title": "Precision",
          "type": "string"
        }
      },
      "required": [
        "value",
        "precision"
      ],
      "title": "PrecisionDate",
      "type": "object"
    },
    "ProfileApprovalMetadata": {
      "additionalProperties": false,
      "description": "Metadata recording human approval of the candidate profile.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "is_approved": {
          "description": "Whether this profile snapshot is approved for use",
          "title": "Is Approved",
          "type": "boolean"
        },
        "approved_by": {
          "description": "Identity of the approver (candidate)",
          "minLength": 1,
          "title": "Approved By",
          "type": "string"
        },
        "approved_at": {
          "description": "UTC timestamp of approval",
          "format": "date-time",
          "title": "Approved At",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional approval notes or version summary",
          "title": "Notes"
        }
      },
      "required": [
        "is_approved",
        "approved_by",
        "approved_at"
      ],
      "title": "ProfileApprovalMetadata",
      "type": "object"
    },
    "ProfileSnapshot": {
      "additionalProperties": false,
      "description": "C01 Candidate Profile Snapshot.\n\nImmutable snapshot of candidate facts and explicit eligibility.\nBoth context strategies consume this exact approved snapshot.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "candidate_id": {
          "description": "Persistent candidate UUID",
          "format": "uuid",
          "title": "Candidate Id",
          "type": "string"
        },
        "profile_version": {
          "description": "Version string for this snapshot",
          "minLength": 1,
          "title": "Profile Version",
          "type": "string"
        },
        "approval_metadata": {
          "$ref": "#/$defs/ProfileApprovalMetadata"
        },
        "explicit_eligibility": {
          "$ref": "#/$defs/CandidateEligibility"
        },
        "evidence_records": {
          "description": "List of approved candidate evidence facts",
          "items": {
            "$ref": "#/$defs/CandidateFact"
          },
          "title": "Evidence Records",
          "type": "array"
        }
      },
      "required": [
        "candidate_id",
        "profile_version",
        "approval_metadata",
        "explicit_eligibility"
      ],
      "title": "ProfileSnapshot",
      "type": "object"
    },
    "SalaryPeriod": {
      "description": "Salary payment period.",
      "enum": [
        "hourly",
        "monthly",
        "yearly"
      ],
      "title": "SalaryPeriod",
      "type": "string"
    },
    "SourceKey": {
      "additionalProperties": false,
      "description": "Unique source posting identity: (provider, board_id, source_posting_id).\n\nTwo postings with the same tuple are the same source posting.\nDifferent board_ids under the same provider are distinct.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "board_id": {
          "minLength": 1,
          "title": "Board Id",
          "type": "string"
        },
        "source_posting_id": {
          "minLength": 1,
          "title": "Source Posting Id",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "board_id",
        "source_posting_id"
      ],
      "title": "SourceKey",
      "type": "object"
    },
    "StructuredLocation": {
      "additionalProperties": false,
      "description": "Structured location preserving original raw text.\n\nA single job posting may have multiple locations.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "raw_text": {
          "description": "Original unparsed location string",
          "minLength": 1,
          "title": "Raw Text",
          "type": "string"
        },
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 3166-1 alpha-2 country code (e.g. 'DE')",
          "title": "Country"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sub-national region or Bundesland (e.g. 'Berlin')",
          "title": "Region"
        },
        "city": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "City name",
          "title": "City"
        },
        "postal_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Postal / ZIP code",
          "title": "Postal Code"
        }
      },
      "required": [
        "raw_text"
      ],
      "title": "StructuredLocation",
      "type": "object"
    },
    "WorkplaceType": {
      "description": "Workplace arrangement type.",
      "enum": [
        "onsite",
        "hybrid",
        "remote",
        "unknown"
      ],
      "title": "WorkplaceType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Authoritative input envelope presented to AUTO-02 for evaluation.",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "candidate_id": {
      "description": "Candidate UUID",
      "format": "uuid",
      "title": "Candidate Id",
      "type": "string"
    },
    "salesforce_org_id": {
      "description": "Salesforce Org ID",
      "title": "Salesforce Org Id",
      "type": "string"
    },
    "canonical_job_id": {
      "description": "Canonical job UUID",
      "format": "uuid",
      "title": "Canonical Job Id",
      "type": "string"
    },
    "lineage_job_ids": {
      "description": "Associated alias/split canonical IDs",
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Lineage Job Ids",
      "type": "array"
    },
    "assessment_id": {
      "description": "Selected C11 Assessment UUID",
      "format": "uuid",
      "title": "Assessment Id",
      "type": "string"
    },
    "assessment_input_fingerprint": {
      "description": "SHA-256 MATCH-02 assessment input fingerprint",
      "title": "Assessment Input Fingerprint",
      "type": "string"
    },
    "assessment_disposition": {
      "$ref": "#/$defs/AssessmentDisposition",
      "description": "C11 disposition (eligible, review, rejected)"
    },
    "assessment_method": {
      "default": "llm",
      "description": "Assessment method: 'llm' or 'rules'",
      "title": "Assessment Method",
      "type": "string"
    },
    "relevance_score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Numeric relevance score on 0-100 scale",
      "title": "Relevance Score"
    },
    "score_scale": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "0-100",
      "description": "Score scale",
      "title": "Score Scale"
    },
    "evaluated_at": {
      "description": "Timestamp when assessment was performed",
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "posting_revision_id": {
      "description": "Posting revision UUID or ID",
      "title": "Posting Revision Id",
      "type": "string"
    },
    "posting_revision_hash": {
      "description": "SHA-256 posting revision hash",
      "title": "Posting Revision Hash",
      "type": "string"
    },
    "normalized_content_hash": {
      "description": "SHA-256 material content hash of normalized posting",
      "title": "Normalized Content Hash",
      "type": "string"
    },
    "posting_snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/NormalizedPosting"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Normalized posting snapshot"
    },
    "profile_version": {
      "description": "Approved candidate profile version",
      "title": "Profile Version",
      "type": "string"
    },
    "profile_digest": {
      "description": "Approved profile snapshot content digest",
      "title": "Profile Digest",
      "type": "string"
    },
    "profile_snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProfileSnapshot"
        },
        {
          "type": "null"
        }
      ],
      "default": null,

{
  "$defs": {
    "ClassifiedError": {
      "additionalProperties": false,
      "description": "Classified operational or domain error.\n\nDistinguishes recoverable failures from permanent errors and maps\nto the system error taxonomy without arbitrary tool or shell authority.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/ErrorCategory"
        },
        "message": {
          "description": "Safe diagnostic message without credentials or tokens",
          "title": "Message",
          "type": "string"
        },
        "recoverable": {
          "description": "Whether this error category is eligible for bounded retry",
          "title": "Recoverable",
          "type": "boolean"
        },
        "field_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional field path if the error pertains to a specific field",
          "title": "Field Path"
        },
        "details": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Safe non-sensitive contextual details",
          "title": "Details"
        }
      },
      "required": [
        "category",
        "message",
        "recoverable"
      ],
      "title": "ClassifiedError",
      "type": "object"
    },
    "ErrorCategory": {
      "description": "Classified error category for failure handling and recovery.",
      "enum": [
        "validation",
        "missing_configuration",
        "permission",
        "authentication",
        "rate_limit",
        "transient_network",
        "transient_service",
        "context_budget",
        "model_output",
        "capacity",
        "unsupported_input"
      ],
      "title": "ErrorCategory",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Summary of a bounded outbox drain pass.",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "operations_claimed": {
      "default": 0,
      "title": "Operations Claimed",
      "type": "integer"
    },
    "steps_succeeded": {
      "default": 0,
      "title": "Steps Succeeded",
      "type": "integer"
    },
    "steps_failed": {
      "default": 0,
      "title": "Steps Failed",
      "type": "integer"
    },
    "steps_reconciled": {
      "default": 0,
      "title": "Steps Reconciled",
      "type": "integer"
    },
    "remaining_due": {
      "default": 0,
      "title": "Remaining Due",
      "type": "integer"
    },
    "errors": {
      "items": {
        "$ref": "#/$defs/ClassifiedError"
      },
      "title": "Errors",
      "type": "array"
    }
  },
  "title": "DrainResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-automation.local/schemas/v1/sync_drain_result.schema.json"
}

{
  "$defs": {
    "AncestorContext": {
      "additionalProperties": false,
      "description": "Structured permitted ancestor anchor attached to child evidence.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "fact_id": {
          "description": "UUID of the ancestor fact",
          "format": "uuid",
          "title": "Fact Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceFactKind",
          "description": "Evidence kind of the ancestor"
        },
        "title": {
          "description": "Headline or title of the ancestor fact",
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "organization": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Employer, client, or institution organization",
          "title": "Organization"
        },
        "start_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrecisionDate"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Start date with explicit precision"
        },
        "end_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrecisionDate"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "End date with explicit precision"
        },
        "parent_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Parent UUID of this ancestor if part of a deeper hierarchy",
          "title": "Parent Id"
        },
        "provenance": {
          "default": "unspecified",
          "description": "Exact approved provenance string from C01",
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        },
        "allowed_uses": {
          "description": "Approved allowed uses of this ancestor fact",
          "items": {
            "type": "string"
          },
          "title": "Allowed Uses",
          "type": "array"
        }
      },
      "required": [
        "fact_id",
        "kind",
        "title"
      ],
      "title": "AncestorContext",
      "type": "object"
    },
    "BindingTransition": {
      "additionalProperties": false,
      "description": "Record of binding state change for an individual chunk identity.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "chunk_id": {
          "description": "UUID of the affected chunk",
          "format": "uuid",
          "title": "Chunk Id",
          "type": "string"
        },
        "old_binding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Old binding fingerprint if present in base manifest",
          "title": "Old Binding"
        },
        "new_binding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "New binding fingerprint if present in target manifest",
          "title": "New Binding"
        },
        "reason_code": {
          "description": "Code: 'added', 'removed_tombstone', 'content_updated', 'rebound_snapshot'",
          "minLength": 1,
          "title": "Reason Code",
          "type": "string"
        }
      },
      "required": [
        "chunk_id",
        "reason_code"
      ],
      "title": "BindingTransition",
      "type": "object"
    },
    "CandidateEvidenceReference": {
      "additionalProperties": false,
      "description": "Reference citing an approved candidate profile fact.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_kind": {
          "const": "candidate",
          "default": "candidate",
          "title": "Source Kind",
          "type": "string"
        },
        "profile_version": {
          "description": "Version of the profile snapshot",
          "minLength": 1,
          "title": "Profile Version",
          "type": "string"
        },
        "fact_id": {
          "description": "UUID of the cited candidate fact",
          "format": "uuid",
          "title": "Fact Id",
          "type": "string"
        }
      },
      "required": [
        "profile_version",
        "fact_id"
      ],
      "title": "CandidateEvidenceReference",
      "type": "object"
    },
    "ChunkChangeSet": {
      "additionalProperties": false,
      "description": "Detailed invalidation and diff report between base and target chunk sets.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "candidate_id": {
          "description": "UUID of the candidate",
          "format": "uuid",
          "title": "Candidate Id",
          "type": "string"
        },
        "purpose": {
          "description": "Inclusion purpose applied",
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "base_manifest_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Manifest fingerprint of base ChunkSet, or None for initial build",
          "title": "Base Manifest Fingerprint"
        },
        "target_manifest_fingerprint": {
          "description": "Manifest fingerprint of target ChunkSet",
          "minLength": 1,
          "title": "Target Manifest Fingerprint",
          "type": "string"
        },
        "added_chunk_ids": {
          "description": "Chunk IDs present in target but not in base",
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Added Chunk Ids",
          "type": "array"
        },
        "removed_chunk_ids": {
          "description": "Chunk IDs present in base but absent from target (tombstones)",
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Removed Chunk Ids",
          "type": "array"
        },
        "content_changed_chunk_ids": {
          "description": "Chunk IDs present in both with changed content version",
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Content Changed Chunk Ids",
          "type": "array"
        },
        "rebound_unchanged_chunk_ids": {
          "description": "Chunk IDs present in both with identical content version but new binding",
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Rebound Unchanged Chunk Ids",
          "type": "array"
        },
        "binding_transitions": {
          "description": "Per-chunk transition descriptors",
          "items": {
            "$ref": "#/$defs/BindingTransition"
          },
          "title": "Binding Transitions",
          "type": "array"
        },
        "reasons": {
          "description": "Summary diagnostic reason strings",
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "replacement_required": {
          "default": false,
          "description": "True if downstream index requires mutation/replacement",
          "title": "Replacement Required",
          "type": "boolean"
        }
      },
      "required": [
        "candidate_id",
        "purpose",
        "target_manifest_fingerprint"
      ],
      "title": "ChunkChangeSet",
      "type": "object"
    },
    "ChunkSet": {
      "additionalProperties": false,
      "description": "Complete manifest of evidence chunks for an approved snapshot and purpose.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "candidate_id": {
          "description": "UUID of the candidate",
          "format": "uuid",
          "title": "Candidate Id",
          "type": "string"
        },
        "profile_version": {
          "description": "Exact profile snapshot version",
          "minLength": 1,
          "title": "Profile Version",
          "type": "string"
        },
        "purpose": {
          "description": "Inclusion purpose applied",
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "snapshot_fingerprint": {
          "description": "SHA-256 digest of the approved profile snapshot",
          "minLength": 1,
          "title": "Snapshot Fingerprint",
          "type": "string"
        },
        "inclusion_rule_version": {
          "default": "v1",
          "minLength": 1,
          "title": "Inclusion Rule Version",
          "type": "string"
        },
        "chunking_version": {
          "default": "v1",
          "minLength": 1,
          "title": "Chunking Version",
          "type": "string"
        },
        "settings_fingerprint": {
          "description": "SHA-256 digest of effective chunking settings",
          "minLength": 1,
          "title": "Settings Fingerprint",
          "type": "string"
        },
        "chunks": {
          "description": "Ordered list of evidence chunks",
          "items": {
            "$ref": "#/$defs/EvidenceChunk"
          },
          "title": "Chunks",
          "type": "array"
        },
        "eligible_fact_ids": {
          "description": "All eligible fact UUIDs in deterministic order",
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Eligible Fact Ids",
          "type": "array"
        },
        "coverage_fact_ids": {
          "description": "Fact UUIDs covered by chunks",
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Coverage Fact Ids",
          "type": "array"
        },
        "excluded_fact_count": {
          "default": 0,
          "description": "Count of facts excluded by purpose permissions",
          "minimum": 0,
          "title": "Excluded Fact Count",
          "type": "integer"
        },
        "warnings": {
          "description": "Deterministic inclusion and chunking warnings",
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "manifest_fingerprint": {
          "description": "SHA-256 digest over the complete manifest binding",
          "minLength": 1,
          "title": "Manifest Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "profile_version",
        "purpose",
        "snapshot_fingerprint",
        "settings_fingerprint",
        "manifest_fingerprint"
      ],
      "title": "ChunkSet",
      "type": "object"
    },
    "ChunkSourceMapping": {
      "additionalProperties": false,
      "description": "Fine-grained mapping linking a chunk assertion back to an approved C01 field.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "reference": {
          "$ref": "#/$defs/CandidateEvidenceReference",
          "description": "C08 candidate reference (profile_version, fact_id)"
        },
        "field_path": {
          "description": "Field path in source fact (e.g. 'title', 'claims[0]', 'skills[2]')",
          "minLength": 1,
          "title": "Field Path",
          "type": "string"
        },
        "list_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "0-based list index for claims, skills, or metrics",
          "title": "List Index"
        },
        "exact_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact string value from the approved source field",
          "title": "Exact Value"
        },
        "char_span": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional character span within the field"
        },
        "is_ancestor_context": {
          "default": false,
          "description": "True if this mapping cites ancestor context rather than primary evidence",
          "title": "Is Ancestor Context",
          "type": "boolean"
        }
      },
      "required": [
        "reference",
        "field_path"
      ],
      "title": "ChunkSourceMapping",
      "type": "object"
    },
    "EmbeddingConfiguration": {
      "additionalProperties": false,
      "description": "Measured embedding model configuration, dimensions, and execution parameters.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "configuration_version": {
          "default": "v1",
          "title": "Configuration Version",
          "type": "string"
        },
        "model_identifier": {
          "description": "Model identifier or tag (e.g. nomic-embed-text)",
          "minLength": 1,
          "title": "Model Identifier",
          "type": "string"
        },
        "dimension": {
          "description": "Embedding vector dimension",
          "exclusiveMinimum": 0,
          "title": "Dimension",
          "type": "integer"
        },
        "model_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Immutable SHA-256 digest of model weights/manifest if verified",
          "title": "Model Digest"
        },
        "expected_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Expected model digest configured for drift detection",
          "title": "Expected Digest"
        },
        "verification_provenance": {
          "default": "model_02_recommendation",
          "description": "Origin of verification (e.g. 'model_02_recommendation', 'synthetic_fake')",
          "title": "Verification Provenance",
          "type": "string"
        },
        "runtime_version": {
          "default": "1.0",
          "minLength": 1,
          "title": "Runtime Version",
          "type": "string"
        },
        "provider_version": {
          "default": "1.0",
          "minLength": 1,
          "title": "Provider Version",
          "type": "string"
        },
        "document_prefix": {
          "default": "",
          "description": "Prefix prepended to document chunks before embedding (e.g. 'search_document: ')",
          "title": "Document Prefix",
          "type": "string"
        },
        "query_prefix": {
          "default": "",
          "description": "Prefix prepended to query text before embedding (e.g. 'search_query: ')",
          "title": "Query Prefix",
          "type": "string"
        },
        "output_affecting_options": {
          "additionalProperties": true,
          "description": "Options that affect numerical embedding output",
          "title": "Output Affecting Options",
          "type": "object"
        },
        "measurement_method": {
          "default": "character_ratio",
          "description": "Tokenizer or estimator method used for input measurement",
          "title": "Measurement Method",
          "type": "string"
        },
        "max_input_tokens": {
          "default": 512,
          "description": "Maximum tokens per single text chunk",
          "exclusiveMinimum": 0,
          "title": "Max Input Tokens",
          "type": "integer"
        },
        "max_batch_items": {
          "default": 32,
          "description": "Maximum items per embedding API call",
          "exclusiveMinimum": 0,
          "title": "Max Batch Items",
          "type": "integer"
        },
        "max_batch_bytes": {
          "default": 1048576,
          "description": "Maximum combined UTF-8 bytes per embedding batch",
          "exclusiveMinimum": 0,
          "title": "Max Batch Bytes",
          "type": "integer"
        },
        "model_02_report_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reference identifier or file path of MODEL-02 benchmark report",
          "title": "Model 02 Report Ref"
        },
        "model_02_report_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SHA-256 content hash of MODEL-02 benchmark report",
          "title": "Model 02 Report Hash"
        }
      },
      "required": [
        "model_identifier",
        "dimension"
      ],
      "title": "EmbeddingConfiguration",
      "type": "object"
    },
    "EvidenceChunk": {
      "additionalProperties": false,
      "description": "Deterministic, versioned evidence chunk representing one primary fact.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "chunk_id": {
          "description": "Stable UUIDv5 derived from candidate_id, purpose, fact_id, slot",
          "format": "uuid",
          "title": "Chunk Id",
          "type": "string"
        },
        "chunk_version": {
          "description": "SHA-256 content fingerprint over normalized projection",
          "minLength": 1,
          "title": "Chunk Version",
          "type": "string"
        },
        "candidate_id": {
          "description": "UUID of the candidate",
          "format": "uuid",
          "title": "Candidate Id",
          "type": "string"
        },
        "profile_version": {
          "description": "Exact C01 profile version cited",
          "minLength": 1,
          "title": "Profile Version",
          "type": "string"
        },
        "purpose": {
          "description": "Inclusion purpose applied",
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "primary_fact_id": {
          "description": "UUID of the primary CandidateFact",
          "format": "uuid",
          "title": "Primary Fact Id",
          "type": "string"
        },
        "primary_kind": {
          "$ref": "#/$defs/EvidenceFactKind",
          "description": "Kind of the primary fact"
        },
        "parent_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Original direct parent ID if hierarchical",
          "title": "Parent Id"
        },
        "ancestor_context": {
          "description": "Ordered permitted ancestor anchors",
          "items": {
            "$ref": "#/$defs/AncestorContext"
          },
          "title": "Ancestor Context",
          "type": "array"
        },
        "title": {
          "description": "Primary headline / title",
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "organization": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Primary employer or institution",
          "title": "Organization"
        },
        "start_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrecisionDate"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Primary start date"
        },
        "end_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrecisionDate"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Primary end date"
        },
        "skills": {
          "description": "Demonstrated skills attached to this primary fact",
          "items": {
            "type": "string"
          },
          "title": "Skills",
          "type": "array"
        },
        "claims": {
          "description": "Specific factual claims / accomplishments",
          "items": {
            "type": "string"
          },
          "title": "Claims",
          "type": "array"
        },
        "metrics": {
          "description": "Verified quantitative metrics",
          "items": {
            "type": "string"
          },
          "title": "Metrics",
          "type": "array"
        },
        "provenance": {
          "default": "unspecified",
          "description": "Exact approved provenance string from primary fact",
          "minLength": 1,
          "title": "Provenance",
          "type": "string"
        },
        "primary_allowed_uses": {
          "description": "Allowed uses declared on the primary fact",
          "items": {
            "type": "string"
          },
          "title": "Primary Allowed Uses",
          "type": "array"
        },
        "effective_allowed_uses": {
          "description": "Intersection of allowed uses across primary and included ancestors",
          "items": {
            "type": "string"
          },
          "title": "Effective Allowed Uses",
          "type": "array"
        },
        "sources": {
          "description": "Complete field-level source mappings to approved snapshot",
          "items": {
            "$ref": "#/$defs/ChunkSourceMapping"
          },
          "title": "Sources",
          "type": "array"
        },
        "retrieval_text": {
          "description": "Deterministic formatted text for retrieval and model consumption",
          "minLength": 1,
          "title": "Retrieval Text",
          "type": "string"
        },
        "dependency_fingerprints": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "SHA-256 fingerprint for each contributing fact (primary and ancestors)",
          "title": "Dependency Fingerprints",
          "type": "object"
        },
        "contextual_limitations": {
          "description": "Explicit limitations (e.g. omitted restricted parent references)",
          "items": {
            "type": "string"
          },
          "title": "Contextual Limitations",
          "type": "array"
        },
        "binding_fingerprint": {
          "description": "SHA-256 fingerprint binding chunk to exact snapshot and C08 citations",
          "minLength": 1,
          "title": "Binding Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "chunk_id",
        "chunk_version",
        "candidate_id",
        "profile_version",
        "purpose",
        "primary_fact_id",
        "primary_kind",
        "title",
        "retrieval_text",
        "binding_fingerprint"
      ],
      "title": "EvidenceChunk",
      "type": "object"
    },
    "EvidenceFactKind": {
      "description": "Kind of candidate evidence fact.",
      "enum": [
        "employment",
        "education",
        "certification",
        "skill",
        "language",
        "project",
        "publication",
        "award",
        "volunteer",
        "other"
      ],
      "title": "EvidenceFactKind",
      "type": "string"
    },
    "IndexSettings": {
      "additionalProperties": false,
      "description": "Configuration, layout, and capacity limits for local vector and keyword indexing.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "index_version": {
          "default": "v1",
          "title": "Index Version",
          "type": "string"
        },
        "algorithm_version": {
          "default": "v1",
          "title": "Algorithm Version",
          "type": "string"
        },
        "format_version": {
          "default": "v1",
          "title": "Format Version",
          "type": "string"
        },
        "canonicalization_version": {
          "default": "v1",
          "title": "Canonicalization Version",
          "type": "string"
        },
        "dtype": {
          "const": "float32",
          "default": "float32",
          "title": "Dtype",
          "type": "string"
        },
        "byte_order": {
          "const": "little_endian",
          "default": "little_endian",
          "title": "Byte Order",
          "type": "string"
        },
        "metric": {
          "default": "cosine",
          "enum": [
            "cosine",
            "dot_product",
            "euclidean"
          ],
          "title": "Metric",
          "type": "string"
        },
        "normalization": {
          "default": "l2",
          "enum": [
            "l2",
            "none"
          ],
          "title": "Normalization",
          "type": "string"
        },
        "analyzer_version": {
          "default": "v1",
          "title": "Analyzer Version",
          "type": "string"
        },
        "analyzer_options": {
          "additionalProperties": true,
          "title": "Analyzer Options",
          "type": "object"
        },
        "max_chunks": {
          "default": 10000,
          "description": "Maximum chunks permitted in an index",
          "exclusiveMinimum": 0,
          "title": "Max Chunks",
          "type": "integer"
        },
        "max_dimension": {
          "default": 4096,
          "description": "Maximum vector embedding dimension",
          "exclusiveMinimum": 0,
          "title": "Max Dimension",
          "type": "integer"
        },
        "max_text_bytes": {
          "default": 65536,
          "description": "Maximum bytes for an individual chunk's retrieval_text",
          "exclusiveMinimum": 0,
          "title": "Max Text Bytes",
          "type": "integer"
        },
        "max_build_memory_bytes": {
          "default": 1073741824,
          "description": "Maximum estimated working memory for build (1 GB)",
          "exclusiveMinimum": 0,
          "title": "Max Build Memory Bytes",
          "type": "integer"
        },
        "max_disk_bytes": {
          "default": 10737418240,
          "description": "Maximum disk space allocated for index storage (10 GB)",
          "exclusiveMinimum": 0,
          "title": "Max Disk Bytes",
          "type": "integer"
        },
        "max_build_time_seconds": {
          "default": 300.0,
          "description": "Maximum wall-clock seconds for a full index build",
          "exclusiveMinimum": 0.0,
          "title": "Max Build Time Seconds",
          "type": "number"
        },
        "cleanup_retained_generations": {
          "default": 2,
          "description": "Number of retired generations to retain for audit/recovery",
          "minimum": 0,
          "title": "Cleanup Retained Generations",
          "type": "integer"
        }
      },
      "title": "IndexSettings",
      "type": "object"
    },
    "PrecisionDate": {
      "additionalProperties": false,
      "description": "Date with explicit precision: day, month, or year.\n\nMonth precision '2021-05' stays as-is; no day is fabricated.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "value": {
          "description": "ISO date string matching the precision",
          "title": "Value",
          "type": "string"
        },
        "precision": {
          "enum": [
            "day",
            "month",
            "year"
          ],
          "title": "Precision",
          "type": "string"
        }
      },
      "required": [
        "value",
        "precision"
      ],
      "title": "PrecisionDate",
      "type": "object"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "description": "Character offsets within a source field.",
      "properties": {
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start": {
          "description": "0-based start character index",
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "description": "0-based end character index (exclusive)",
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "SourceSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Explicit bound request to construct a local vector and keyword index.",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "candidate_id": {
      "description": "UUID of the candidate",
      "format": "uuid",
      "title": "Candidate Id",
      "type": "string"
    },
    "profile_version": {
      "description": "Target profile snapshot version",
      "minLength": 1,
      "title": "Profile Version",
      "type": "string"
    },
    "purpose": {
      "description": "Target inclusion purpose",
      "minLength": 1,
      "title": "Purpose",
      "type": "string"
    },
    "chunk_set": {
      "$ref": "#/$defs/ChunkSet",
      "description": "Complete validated CONTEXT-02 chunk set"
    },
    "embedding_config": {
      "$ref": "#/$defs/EmbeddingConfiguration",
      "description": "Measured embedding model configuration"
    },
    "settings": {
      "$ref": "#/$defs/IndexSettings",
      "description": "Index settings"
    },
    "build_mode": {
      "default": "full_rebuild",
      "description": "Build mode: full_rebuild (default and required for v1)",
      "enum": [
        "full_rebuild",
        "incremental"
      ],
      "title": "Build Mode",
      "type": "string"
    },
    "expected_prior_token": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional expected prior activation token for compare-and-swap activation",
      "title": "Expected Prior Token"
    },
    "change_set": {
      "anyOf": [
        {
          "$ref": "#/$defs/ChunkChangeSet"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional change set provided as an advisory hint"
    }
  },
  "required": [
    "candidate_id",
    "profile_version",
    "purpose",
    "chunk_set",
    "embedding_config"
  ],
  "title": "IndexBuildRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-automation.local/schemas/v1/index_build_request.schema.json"
}
